# This file is automatically generated - do not edit manually

# Project information (populated by CMake)
set(CTEST_PROJECT_NAME "@PROJECT_NAME@")
set(CTEST_NIGHTLY_START_TIME "01:00:00 UTC")

# CDash server configuration
# set(CTEST_SUBMIT_URL "https://my.cdash.org/submit.php?project=${CTEST_PROJECT_NAME}")

set(CTEST_SUBMIT_URL "@CTEST_SUBMIT_URL@")

IF(NOT CTEST_SUBMIT_URL)
  SET(CTEST_SUBMIT_URL "https://my.cdash.org/submit.php?project=elmertestdevel")
ENDIF()

# Set bearer token. Problem: this file will be saved in the filesystem so
# anyone can read it.
SET(CDASH_TOKEN "@CDASH_TOKEN@")

# Get bearer token from environment
IF(NOT CDASH_TOKEN)
  SET(CDASH_TOKEN "$ENV{CDASH_BEARER_TOKEN}")
ENDIF()

if(NOT CDASH_TOKEN)
    message(WARNING "CDASH_BEARER_TOKEN environment variable not set")
else()
    set(CTEST_SUBMIT_HEADERS "Authorization: Bearer ${CDASH_TOKEN}")
endif()

# Directories (populated by CMake configure_file)
set(CTEST_SOURCE_DIRECTORY "@CMAKE_SOURCE_DIR@")
set(CTEST_BINARY_DIRECTORY "@CMAKE_BINARY_DIR@")

# Build configuration (populated by CMake)
set(CTEST_CONFIGURATION_TYPE "@CMAKE_BUILD_TYPE@")
set(CTEST_CMAKE_GENERATOR "@CMAKE_GENERATOR@")

# Detect number of cores for parallel building
include(ProcessorCount)
ProcessorCount(NCORES)
if(NCORES EQUAL 0)
    set(NCORES 1)
endif()
IF(NCORES GREATER_EQUAL 10)
  set(NCORES 10)
ENDIF()
message("Using ${NCORES} cores for building")

# Use cmake --build which works with all generators
set(CTEST_BUILD_COMMAND "cmake --build . --config ${CTEST_CONFIGURATION_TYPE} --parallel ${NCORES}")

# Build name for CDash dashboard
set(CTEST_BUILD_NAME "@CMAKE_SYSTEM_NAME@-@CMAKE_SYSTEM_PROCESSOR@-@CMAKE_BUILD_TYPE@")
if(DEFINED ENV{BUILD_NAME_SUFFIX})
    set(CTEST_BUILD_NAME "${CTEST_BUILD_NAME}-$ENV{BUILD_NAME_SUFFIX}")
endif()

# Site name
if(DEFINED ENV{CTEST_SITE})
    set(CTEST_SITE "$ENV{CTEST_SITE}")
else()
    site_name(CTEST_SITE)
endif()

message("=== CTest Dashboard Configuration ===")
message("Project: ${CTEST_PROJECT_NAME}")
message("Site: ${CTEST_SITE}")
message("Build Name: ${CTEST_BUILD_NAME}")
message("Generator: ${CTEST_CMAKE_GENERATOR}")
message("Source Directory: ${CTEST_SOURCE_DIRECTORY}")
message("Binary Directory: ${CTEST_BINARY_DIRECTORY}")
message("Build Type: ${CTEST_CONFIGURATION_TYPE}")
message("========================================")

# Start dashboard
ctest_start("Experimental")

# 
set(ENV{CTEST_OUTPUT_ON_FAILURE} 1)

# Build the project
message("Building project...")
ctest_build(
    BUILD "${CTEST_BINARY_DIRECTORY}"
    RETURN_VALUE build_result
    NUMBER_ERRORS build_errors
    NUMBER_WARNINGS build_warnings
)

message("Build completed - Errors: ${build_errors}, Warnings: ${build_warnings}")

if(build_result)
    message(WARNING "Build failed with return code: ${build_result}")
endif()

# Run tests
message("Running tests...")
ctest_test(
    BUILD "${CTEST_BINARY_DIRECTORY}"
    RETURN_VALUE test_result
)

if(test_result)
    message(WARNING "Some tests failed")
endif()

# Submit results to CDash
ctest_submit(
    RETURN_VALUE submit_result
    HTTPHEADER "${CTEST_SUBMIT_HEADERS}"
)

if(submit_result)
  message(WARNING "CDash submission failed with error: ${submit_result}")
else()
  message(STATUS "CDash submission results: ${CTEST_SUBMIT_URL}")
endif()

# Print summary
MESSAGE(STATUS "------------------------------------------------")
message("Build: ${build_result} (Errors: ${build_errors}, Warnings: ${build_warnings})")
message("Test: ${test_result}")
message("Submit: ${submit_result}")
MESSAGE(STATUS "------------------------------------------------")
