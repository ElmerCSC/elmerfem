$fprintf( stderr, " \n");
$fprintf( stderr, "TEST CASE EPSG:3031 - polar stereographic south - Hard Coded \n");
$fprintf( stderr, " \n");
Simulation :: projection type = String "polar stereographic south"
Simulation :: central_meridian = Real 0.0
Simulation :: latitude_of_origin = Real -71.0
Solver 1 :: Reference Norm = Real 1.0
Solver 1 :: Reference Norm Tolerance = Real 1E-06
Solver 1 :: Input Filename = File "EPSG3031.txt"
RUN
$fprintf( stderr, "END TEST CASE: Target NRM=1.0,EPS:1E-06\n" );

