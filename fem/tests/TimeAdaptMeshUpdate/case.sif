! Adaptive timestepping with a moving mesh: MeshSolve translates the mesh by
! the boundary displacement 100*t^2 while the heat equation is solved on it.
!
! Every try of adaptive timestepping restores the state before the step, and
! must restore the node coordinates with the Mesh Update. Before, the mesh
! drifted (the max x coordinate ended at 1.0203 instead of 1+100*0.01^2 = 1.01).
!
! MeshSolve is quasi-static (no time derivative term): it is not counted in
! the error estimate, so the steps and the temperature are those of the fixed
! mesh case TimeAdaptPredictor_mpi (0.74129445E-02). Its zero 2nd component did
! once collapse the steps to the minimum size.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "sq"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 2D"
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = 0.001
  Timestep Intervals = 10
  Output Intervals = 0
  Steady State Max Iterations = 1

  Adaptive Timestepping = True
  Adaptive Time Error = 1.0e-3
  Adaptive Keep Smallest = 3
  Adaptive Min Timestep = 1.0e-6
  Adaptive Max Timestep = Real 0.001
End

Body 1
  Name = "Body1"
  Body Force = 1
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equation1"
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "Mesh Update"
  Procedure = "MeshSolve" "MeshSolver"
  Variable = "Mesh Update[Mesh Update:2]"
  Linear System Solver = "Direct"
  Linear System Direct Method = "UMFPack"
End

Solver 2
  Equation = "Heat Equation"
  Procedure = "HeatSolve" "HeatSolver"
  Variable = "Temperature"
  Linear System Solver = "Iterative"
  Linear System Iterative Method = "CG"
  Linear System Max Iterations = 100
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = None
  Lumped Mass Matrix = True
  Nonlinear System Max Iterations = 1
End

Solver 3
  Exec Solver = after timestep
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = coordinate 1
  Operator 1 = max
  Variable 2 = time
  Show Norm Index = 1
End

Material 1
  Name = "Material1"
  Density = 1
  Heat Capacity = 1
  Heat Conductivity = 1
  Poisson Ratio = 0.3
End

Body Force 1
  Name = "BodyForce1"
  Heat Source = 1
End

Boundary Condition 1
  Name = "Constraint1"
  Target Boundaries(1) = 1
  Temperature = 0
  Mesh Update 1 = Variable Time
    Real MATC "100*tx*tx"
  Mesh Update 2 = 0
End

Solver 1 :: Reference Norm = Real 0.70710678E-02
Solver 1 :: Reference Norm Tolerance = Real 1.0e-6
Solver 2 :: Reference Norm = Real 0.74129445E-02
Solver 2 :: Reference Norm Tolerance = Real 1.0e-5
Solver 3 :: Reference Norm = Real 1.01
Solver 3 :: Reference Norm Tolerance = Real 1.0e-8
