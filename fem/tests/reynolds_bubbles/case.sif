! Reynolds solver with "Bubbles = True" on bilinear quads, using the
! two-body case of reynolds_multibody (analytic max FilmPressure 0.9 and
! int FilmPressure Flux 1 = 200, both reproduced to round-off).
! The local basis used to have room for the nodal functions only, so
! ElementInfo skipped the bubbles while the assembly loop read 2*n of them
! (singular condensation).

Header
  Mesh DB "." "rect"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 0
!  Post File = "case.vtu"
End

Body 1
  Name = "Lower"
  Equation = 1
  Material = 1
  Body Force = 1
End

Body 2
  Name = "Upper"
  Equation = 1
  Material = 1
  Body Force = 2
End

Equation 1
  Name = "Eqs"
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "Reynolds"
  Procedure = File "ReynoldsSolver" "ReynoldsSolver"
  Variable = FilmPressure
  Bubbles = Logical True

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack

  Nonlinear System Max Iterations = 1
End

Solver 2
  Equation = "ReynoldsPost"
  Procedure = File "ReynoldsSolver" "ReynoldsPostprocess"
  Calculate Flux = Logical True

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

! Each SaveScalars exposes one analytic value as its norm.
Solver 3
  Exec Solver = after all
  Equation = "SavePressure"
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = FilmPressure
  Operator 1 = max
  Show Norm Index = 1
End

Solver 4
  Exec Solver = after all
  Equation = "SaveFlux"
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = FilmPressure Flux 1
  Operator 1 = int
  Show Norm Index = 1
End

Material 1
  Name = "Viscous"
  Viscosity = Real 1.0e-2
  Gap Height = Real 1.0
End

Body Force 1
  Normal Velocity = Real -1.0e-3
  Tangent Velocity 1 = Real 0.2
End

Body Force 2
  Normal Velocity = Real -3.0e-3
  Tangent Velocity 1 = Real 0.6
End

Boundary Condition 1
  Name = "bottom"
  Target Boundaries(1) = 1
End

Boundary Condition 2
  Name = "right"
  Target Boundaries(1) = 2
End

Boundary Condition 3
  Name = "top"
  Target Boundaries(1) = 3
  FilmPressure = 0.0
End

Boundary Condition 4
  Name = "left"
  Target Boundaries(1) = 4
End

Solver 3 :: Reference Norm = 0.9
Solver 4 :: Reference Norm = 200.0

Solver 3 :: Reference Norm Tolerance = 1.0e-8
Solver 4 :: Reference Norm Tolerance = 1.0e-8
