! Adaptive timestepping with BDF2: heat equation with unit source in a
! square, zero temperature on the boundary.
!
! Each timestep is subdivided adaptively by step doubling. The substeps
! must update the history of timestep sizes used by the variable step
! BDF2, and a rejected step must restore the whole state (values, history,
! the startup counter of BDF). Before that adaptive BDF2 failed at the
! 1st timestep.
!
! The default weighted error measure is used. The reference norm is the
! result of this case; BDF2 with fixed dt=1e-5 gives 0.79426236E-02, the
! original norm-based measure 0.79429233E-02 and adaptive implicit Euler with
! the same settings 0.79298344E-02.
!
! SaveScalars after each accepted substep checks that the "timestep"
! counter is not changed by the substeps.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "Mesh"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 2D"
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = 0.001
  Timestep Intervals = 10
  Output Intervals = 0
  Steady State Max Iterations = 1

  Adaptive Timestepping = True
  Adaptive Time Error = 1.0e-3
  Adaptive Keep Smallest = 3
  Adaptive Min Timestep = 1.0e-6
  Adaptive Max Timestep = Real 0.001
End

Body 1
  Name = "Body1"
  Body Force = 1
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equation1"
  Active Solvers(1) = 1
End

Solver 1
  Equation = "Heat Equation"
  Procedure = "HeatSolve" "HeatSolver"
  Variable = "Temperature"
  Linear System Solver = "Iterative"
  Linear System Iterative Method = "CG"
  Linear System Max Iterations = 100
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = None
  Stabilize = True
  Lumped Mass Matrix = True
  Steady State Convergence Tolerance = 1.0e-05
  Nonlinear System Convergence Tolerance = 1.0e-05
  Nonlinear System Max Iterations = 1
End

Solver 2
  Exec Solver = after timestep
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = timestep
  Show Norm Index = 1
End

Material 1
  Name = "Material1"
  Density = 1
  Heat Capacity = 1
  Heat Conductivity = 1
End

Body Force 1
  Name = "BodyForce1"
  Heat Source = 1
End

Boundary Condition 1
  Name = "Constraint1"
  Target Boundaries(6) = 1 2 3 4 5 6
  Temperature = 0
End

Solver 1 :: Reference Norm = Real 0.79427858E-02
Solver 1 :: Reference Norm Tolerance = Real 1.0e-5
Solver 2 :: Reference Norm = Real 10
Solver 2 :: Reference Norm Tolerance = Real 1.0e-8
