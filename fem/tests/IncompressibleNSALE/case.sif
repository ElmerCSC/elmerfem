! Regression test for ALE ("Mesh Velocity") support in IncompressibleNS.
!
! Poiseuille flow u = (4y(1-y), 0), p = 8*mu*(1-x) in the unit square, on a
! mesh whose interior nodes oscillate vertically: MeshSolve drives
! Mesh Update 2 = A*sin(pi*y)*sin(2*pi*t) on the inlet/outlet, walls fixed.
! The physical flow is steady, but the time derivative Elmer forms follows the
! moving nodes, so IncompressibleNS must convect with u - w (w = Mesh
! Velocity) for the solution to stay Poiseuille.
!
! "Compressibility Model = Thermal" with T = y (HeatSolve, Heat Capacity = 0,
! so T stays exactly linear on the moving mesh) makes rho vary across the
! channel. Poiseuille is still exact (div(rho u) = 0), but now the continuity
! row's d(rho)/dt is also a mesh-point derivative and needs its own
! -w.grad(rho) correction. HeatSolve runs before the timestep so the flow
! solver sees the current T on the current mesh within a single coupled
! iteration; with HeatSolve after the flow solver, coupled iterations
! (Steady State Max Iterations > 1) converge to the same solution.
!
! Max velocity error vs. the exact profile over one period (20x20 mesh, dt=0.005):
!   fixed mesh 3.0e-3; moving mesh with ALE 4.1e-3; without the continuity
!   correction 0.11; with no mesh velocity at all (old behaviour) ~6e-2.
! Refining to 40x40 drops the ALE error ~4x (spatial, 2nd order), while the
! no-mesh-velocity error stays at ~6e-2.

Check Keywords Warn

Header
  Mesh DB "." "channel"
End

$ mu = 0.01
$ A = 0.15

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Sizes = 0.005
  Timestep Intervals = 20
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Initial Condition 1
  Velocity 1 = Variable Coordinate 2
    Real MATC "4*tx*(1-tx)"
  Velocity 2 = 0.0
  Temperature = Variable Coordinate 2
    Real MATC "tx"
  Pressure = Variable Coordinate 1
    Real MATC "8*mu*(1-tx)"
End

Equation 1
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = MeshSolver
  Exec Solver = Before Timestep
  Procedure = "MeshSolve" "MeshSolver"
  Variable = -dofs 2 "Mesh Update"
  Compute Mesh Velocity = True
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Solver 2
  Equation = Heat Equation
  Exec Solver = Before Timestep
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Convection = String "none"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Solver 3
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 20
  Nonlinear System Convergence Tolerance = 1.0e-9
End

Material 1
  Density = 1.0
  Viscosity = $mu
  Compressibility Model = Thermal
  Heat Expansion Coefficient = 0.5
  Reference Temperature = 0.0
  Heat Conductivity = 1.0
  Heat Capacity = 0.0
End

! Walls
Boundary Condition 1
  Target Boundaries(2) = 1 3
  Velocity 1 = 0.0
  Velocity 2 = 0.0
  Temperature = Variable Coordinate 2
    Real MATC "tx"
  Mesh Update 1 = 0.0
  Mesh Update 2 = 0.0
End

! Inlet
Boundary Condition 2
  Target Boundaries = 4
  Velocity 1 = Variable Coordinate 2
    Real MATC "4*tx*(1-tx)"
  Velocity 2 = 0.0
  Mesh Update 1 = 0.0
  Mesh Update 2 = Variable Coordinate 2, Time
    Real MATC "A*sin(pi*tx(0))*sin(2*pi*tx(1))"
End

! Outlet: natural BC, p = 0
Boundary Condition 3
  Target Boundaries = 2
  Velocity 2 = 0.0
  Mesh Update 1 = 0.0
  Mesh Update 2 = Variable Coordinate 2, Time
    Real MATC "A*sin(pi*tx(0))*sin(2*pi*tx(1))"
End

Solver 3 :: Reference Norm = Real 0.49818257
Solver 3 :: Reference Norm Tolerance = Real 1.0e-5
