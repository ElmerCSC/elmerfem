! Steady UMAT case with a spring boundary condition: cantilever beam under a
! body force, the free end supported by a spring.
!
! The unknown of the UMAT formulation is the increment of the displacement:
! the spring force of the current iterate must stay in the residual, else the
! spring acts on the increment only, the Newton iteration of this linear
! problem crawls toward the solution without the spring and stops at the
! iteration limit. The reference is the result of the linear elastic material
! of ElasticSolve (the minimum vertical displacement).

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "beam"
End
Simulation
  Max Output Level = 4
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 0
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Body Force 1
  Stress Bodyforce 2 = -1.0e5
End
Material 1
  Number of Material Constants = Integer 3
  Number of State Variables = Integer 0
  Material Constants(3) = Real 2700.0 70e9 0.3
  UMAT Subroutine = File "UMATLib" "linear_isotropic"
  Name = "linear isotropic"
  Density = 2700.0
  Reference Temperature = 293.0
End
Solver 1
  Equation = Elasticity Solver
  Variable = Displacement
  Variable DOFs = 2
  Procedure = "ElasticSolve" "ElasticSolver"
  Linear System Solver = Direct
  Nonlinear System Max Iterations = 10
  Nonlinear System Convergence Tolerance = 1.0e-9
  Large Deflection = False

End
Solver 2
  Exec Solver = After All
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = f.dat
  Variable 1 = Time
  Variable 2 = Displacement 2
  Operator 2 = min
  Show Norm Index = 2
End
Equation 1
  Active Solvers(2) = 1 2
  Plane Stress = False
End
Boundary Condition 1
  Target Boundaries = 1
  Displacement 1 = 0
  Displacement 2 = 0
End

Boundary Condition 2
  Target Boundaries = 4
  Spring 2 = Real 1.0e9
End

Solver 2 :: Reference Norm = Real 3.15281331E-05
Solver 2 :: Reference Norm Tolerance = Real 1.0e-7
