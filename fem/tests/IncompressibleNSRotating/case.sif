! Regression test for the rotating frame of reference in IncompressibleNS:
! Body Force "Angular Velocity(3)" (same keyword as FlowSolve.F90), giving the
! Coriolis force rho*2 Omega x u and the centrifugal load
! -rho*Omega x (Omega x x).
!
! Manufactured solution in the unit cube, rho = 1.3, mu = 0.1,
! Omega = (0.3, -0.7, 1.1) -- all three components non-zero on purpose:
!   u = (y, z, x)  (divergence free),  p = 0
! with the body force (given per unit mass, as Flow Bodyforce is multiplied
! by rho) balancing convection (u.grad)u = (z, x, y), Coriolis and centrifugal:
!   f = (u.grad)u + 2 Omega x u + Omega (Omega.x) - |Omega|^2 x.
! The linear exact solution lies in the equal-order P1 space and every term
! of the stabilised residual vanishes on it (the viscous one is zero for a
! linear u), so the discrete solution reproduces it to round-off: max nodal
! error ~1e-12. Leaving the Coriolis term out of the PSPG/SUPG residual, or a
! wrong sign or index in Omega x u, shows up as an O(0.1) error.
!
! Legacy FlowSolve used to get this wrong in 3D whenever Omega_y /= 0 (an
! index bug in NavierStokes.F90's Coriolis block) and with its "Stabilized"
! method (Coriolis missing from the residual); both fixed, see test
! FlowSolveRotating.

Check Keywords Warn
Header
  Mesh DB "." "cube"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End
Equation 1
  Active Solvers(1) = 1
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 50
  Nonlinear System Convergence Tolerance = 1.0e-12
  Pressure Stabilization = True
End
Material 1
  Density = 1.3
  Viscosity = 0.1
End
Body Force 1
  Angular Velocity(3) = Real 0.3 -0.7 1.1
  Flow Bodyforce 1 = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "tx(2)+2*((-0.7)*(tx(0))-(1.1)*(tx(2)))+(0.3)*((0.3)*(tx(0))+(-0.7)*(tx(1))+(1.1)*(tx(2)))-(1.79)*(tx(0))"
  Flow Bodyforce 2 = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "tx(0)+2*((1.1)*(tx(1))-(0.3)*(tx(0)))+(-0.7)*((0.3)*(tx(0))+(-0.7)*(tx(1))+(1.1)*(tx(2)))-(1.79)*(tx(1))"
  Flow Bodyforce 3 = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "tx(1)+2*((0.3)*(tx(2))-(-0.7)*(tx(1)))+(1.1)*((0.3)*(tx(0))+(-0.7)*(tx(1))+(1.1)*(tx(2)))-(1.79)*(tx(2))"
End
Boundary Condition 1
  Target Boundaries(6) = 1 2 3 4 5 6
  Velocity 1 = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "tx(1)"
  Velocity 2 = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "tx(2)"
  Velocity 3 = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "tx(0)"
End
Boundary Condition 2
  Target Coordinates(1,3) = 0.0 0.0 0.0
  Pressure = 0.0
End

! = sqrt(3/8), the exact nodal field
Solver 1 :: Reference Norm = Real 0.61237244
Solver 1 :: Reference Norm Tolerance = Real 1.0e-6
