! Strong (edge-to-surface) generic level projector with first-order Piola edge
! elements on a nonconforming flat mortar interface at z=0.5, where both the slave
! (upper, 4x4) and the master (lower, 3x3) side mix quad faces (2 face DOFs) and
! triangle faces (0 face DOFs); the slave triangles are listed before the quads.
! Dirichlet data is the tangential trace of A = (-y/2, x/2, 0), i.e. B = (0,0,1),
! which lies in the discrete space, so B_z should be reproduced to solver precision.
! Previously, in AddEdgeProjectorStrongGeneric:
!  - face rows were numbered 2*(ind-1), overrunning the projector (Fatal "InvPerm issue"),
!  - the master field was integrated along the slave edge basis function instead of
!    the edge tangent, which is wrong on triangles,
!  - Piola triangle bases were evaluated without converting to the p-reference element.
! Mesh generated with: LOWER_TRI=1 SLAVE_FIRST=303 python3 genmesh.py mixed mesh

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady
  Steady State Max Iterations = 1
End

Body 1
  Target Bodies(2) = 1 2
  Equation = 1
  Material = 1
End

Material 1
  Reluctivity = Real 1.0
End

Equation 1
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Use Piola Transform = Logical True
  Apply Mortar BCs = Logical True

  ! The Lagrange gauge (div A = 0, satisfied by the exact solution) helps GCR.
  Use Lagrange Gauge = Logical True

  Linear System Solver = "Iterative"
  Linear System Iterative Method = GCR
  Linear System GCR Restart = 1000
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Residual Output = 100
  Linear System Abort Not Converged = True
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Magnetic Field Strength = Logical False
  Calculate Nodal Fields = Logical False
  Calculate Elemental Fields = Logical True

  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1.0e-12
End

Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = f.dat

  Variable 1 = Magnetic Flux Density E 3
  Operator 1 = min
  Operator 2 = max
  Variable 2 = Magnetic Flux Density E 1
  Operator 3 = max abs
  Variable 3 = Magnetic Flux Density E 2
  Operator 4 = max abs

  ! Minimum of B_z, exact value 1.0
  Show Norm Index = 1
End

! Slave: bottom of the upper (mixed hex/prism) body
Boundary Condition 1
  Target Boundaries(1) = 1
  Mortar BC = Integer 2
  Level Projector = Logical True
  Level Projector Strong = Logical True
  Flat Projector = Logical True
End

! Master: top of the lower (hex) body
Boundary Condition 2
  Target Boundaries(1) = 2
End

Boundary Condition 3
  Target Boundaries(1) = 3
  AV {e} 1 = Variable Coordinate 2
    Real MATC "-0.5*tx"
  AV {e} 2 = Variable Coordinate 1
    Real MATC "0.5*tx"
  AV {e} 3 = Real 0.0
End

Solver 3 :: Reference Norm = 1.0
Solver 3 :: Reference Norm Tolerance = 1.0e-6
