#####  ElmerGrid input file for structured grid generation  ######
! Two square coils side by side in a box of air. The same geometry is meshed at
! two densities (see runtest.cmake) so that one run can give a circuit solver
! its own mesh.
Version = 210903
Coordinate System = Cartesian 2D
Subcell Divisions in 2D = 5 3
Subcell Limits 1 = 0 0.05 0.10 0.20 0.25 0.30
Subcell Limits 2 = 0 0.10 0.20 0.30
Material Structure in 2D
  1    1    1    1    1
  1    2    1    3    1
  1    1    1    1    1
End
Materials Interval = 1 3
Boundary Definitions
# type     out      int
  1        0        1        1
End
Numbering = Horizontal
Element Degree = 1
Element Innernodes = False
Triangles = True
Surface Elements = 1200
