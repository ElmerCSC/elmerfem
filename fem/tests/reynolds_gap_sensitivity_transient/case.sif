! Gap sensitivity S = dp/dh of a transient Reynolds solution (isothermal
! ideal gas, squeeze velocity growing in time, leakage), after 4 implicit
! Euler steps. The sensitivity has its own time history, zero initially.
! The references are central differences (p(h+d)-p(h-d))/2d, d=1e-5,
! of the final solution of this same case run without the sensitivity.
! The transient sensitivity used to crash (no previous values).

Header
  Mesh DB "." "rect"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Sizes = 5.0
  Timestep Intervals = 4
  Steady State Max Iterations = 1
  Output Intervals = 0
End

Body 1
  Name = "Lower"
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End

Body 2
  Name = "Upper"
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End

Initial Condition 1
  FilmPressure = Real 1.0
End

Equation 1
  Name = "Eqs"
  Active Solvers(1) = 1
End

Solver 1
  Equation = "Reynolds"
  Procedure = File "ReynoldsSolver" "ReynoldsSolver"
  Variable = FilmPressure
  Gap Sensitivity = Logical True

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack

  Nonlinear System Max Iterations = 200
  Nonlinear System Convergence Tolerance = 1.0e-13
End

Solver 2
  Exec Solver = after all
  Equation = "SaveInt"
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = FilmPressure Gap Sensitivity
  Operator 1 = int
  Show Norm Index = 1
End

! Columns: coordinates 1-3, FilmPressure, FilmPressure Gap Sensitivity
Solver 3
  Exec Solver = after all
  Equation = "SavePoint"
  Procedure = "SaveData" "SaveScalars"
  Save Coordinates(1,2) = 5.0 50.0
  Show Norm Index = 5
End

Material 1
  Name = "Gas"
  Viscosity = Real 1.0e-2
  Gap Height = Real 1.0
  Flow Admittance = Real 2.0e-4
  Compressibility Model = String "isothermal ideal gas"
End

Body Force 1
  Normal Velocity = Variable Time
    Real MATC "-2.0e-3*tx"
  External FilmPressure = Real 0.8
End

Boundary Condition 1
  Name = "top"
  Target Boundaries(1) = 3
  FilmPressure = Real 1.0
End

Solver 2 :: Reference Norm = 9.5520225000E+02
Solver 2 :: Reference Norm Tolerance = 1.0e-6
Solver 3 :: Reference Norm = 1.0238010500E+00
Solver 3 :: Reference Norm Tolerance = 1.0e-6
