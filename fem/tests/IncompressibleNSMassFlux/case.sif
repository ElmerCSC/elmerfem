! Regression test for the "Mass Flux" boundary condition in IncompressibleNS
! (as in FlowSolve): m is the mass flux INTO the domain, rho*u.n = -m. It is a
! natural condition of the continuity equation integrated by parts, so it
! needs "GradP Discretization = True" (refused otherwise, where the same load
! would be a mass source on the boundary instead).
!
! Unit square, rho = 1.3, mu = 0.1, Navier-Stokes. Slip walls (Velocity 2 = 0)
! top and bottom, m = 0.65 on the left, pressure 0 at the outlet on the right
! (with GradP the traction-free outlet would not fix the pressure level). The
! exact solution is the plug flow u = (m/rho, 0) = (0.5, 0), p = 0, reproduced
! to round-off: max and min of |u_x| (SaveScalars) are both 0.5. With a
! parabolic m the outflow equals the (nodally interpolated) inflow.

Check Keywords Warn
Header
  Mesh DB "." "square"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  GradP Discretization = True
  
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 50
  Nonlinear System Convergence Tolerance = 1.0e-12
  Nonlinear System Newton After Iterations = 3
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = Velocity 1
  Operator 1 = max abs
  Variable 2 = Velocity 1
  Operator 2 = min abs
  Show Norm Index = 1
End
Material 1
  Density = 1.3
  Viscosity = 0.1
End
Boundary Condition 1
  Name = "walls"
  Target Boundaries(2) = 1 3
  Velocity 2 = 0.0
End
Boundary Condition 2
  Name = "inlet"
  Target Boundaries(1) = 4
  Velocity 2 = 0.0
  Mass Flux = Real 0.65
End
Boundary Condition 3
  Name = "outlet"
  Target Boundaries(1) = 2
  Velocity 2 = 0.0
  Pressure = 0.0
End

! = 0.5/sqrt(2), the exact nodal field
Solver 1 :: Reference Norm = Real 0.353553391
Solver 1 :: Reference Norm Tolerance = Real 1.0e-8
! max |u_x| = 0.5
Solver 2 :: Reference Norm = Real 0.5
Solver 2 :: Reference Norm Tolerance = Real 1.0e-8
