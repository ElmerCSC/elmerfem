!---------------------------------------------------------------------
! Test for FourierLoss when the Fourier cycle does not coincide with
! the timestep grid: "Fourier Start Time" falls inside a timestep, so
! the cycle is started with the left rule and finished with the right
! rule, both using a fractional timestep.
!
! The field is spatially uniform and a known Fourier series in time.
! The field exponent is 2 so that the loss of each harmonic does not
! depend on the phase, i.e. on the start time of the cycle. The cycle
! is an integer number of timesteps, hence the piecewise linear
! interpolant is periodic and the exact integration gives the same
! loss as an aligned start (Fourier Start Time = 1.0). Before the fix of
! the fractional step weights this gave 1.9127E+01 instead of 1.9286E+01.
!--------------------------------------------------------------------

Check Keywords "Warn"

Header
  Mesh DB "." "square"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian

  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals(1) = 120
  Timestep Sizes(1) = 0.025
  Output Intervals(1) = 0
  Steady State Max Iterations = 1

  Frequency = 1.0
End

Body 1
  Equation = 1
  Material = 1
End

Body 2
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Solvers"
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "Poisson"
  Variable = "Potential"
  Procedure = "ModelPDE" "AdvDiffSolver"

  Linear System Solver = "Iterative"
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 1000
  Linear System Convergence Tolerance = 1e-10
  Linear System Iterative Method = BiCGStabL
End

Solver 2
  Equation = "Fourier"
  Procedure = "FourierLoss" "FourierLossSolver"

  Target Variable = String Potential
  Target Variable Direct = Logical True
  Fourier Series Components = Integer 3

! Start in the middle of a timestep (dt=0.025)
  Fourier Start Time = Real 1.01
  Fourier Integrate Cycles = Integer 1

  Harmonic Loss Frequency Exponent(3) = Real 0.0 0.0 0.0
  Harmonic Loss Field Exponent(3) = Real 2.0 2.0 2.0

! The norm is the total loss of the last completed cycle
  Calculate Elemental Fields = True
  Calculate Nodal Fields = False
End

Material 1
  Time Derivative Coefficient = Real 0.0
  Diffusion Coefficient = Real 1.0

  Harmonic Loss Coefficient 1 = Real 1.0
  Harmonic Loss Coefficient 2 = Real 2.0
  Harmonic Loss Coefficient 3 = Real 0.5
End

Boundary Condition 1
  Target Boundaries(4) = 1 2 3 4
  Potential = Variable time
    Real MATC "2+cos(2*pi*tx)+0.5*cos(2*2*pi*tx)+0.25*cos(3*2*pi*tx)+0.4*sin(2*pi*tx)+0.2*sin(2*2*pi*tx)+0.1*sin(3*2*pi*tx)"
End

Solver 2 :: Reference Norm = 1.92862750E+01
