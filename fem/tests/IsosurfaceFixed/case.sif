! Extracts a fixed isoline and remaps a transient field onto it.
!
! The isosurface is taken of "Coordinate 1", i.e. it does not move, so the
! surface is created only on the first timestep and on the subsequent ones
! the solver just interpolates the fields onto the existing isoline. This
! is the "Isosurface Fixed" branch that no other test covers.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "angle"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5

  Coordinate System = "Cartesian"
  Coordinate Mapping(3) = 1 2 3

  Simulation Type = "Transient"
  Timestepping Method = "BDF"
  BDF Order = 1
  Timestep Sizes(1) = 0.05
  Timestep Intervals(1) = 4
  Steady State Max Iterations = 1
  Output Intervals = 0

  Post File = "TempDist.vtu"
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
End

Body 1
  Name = "Body"
  Body Force = 1
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equations"
  Active Solvers(1) = 1
End

Solver 1
  Exec Solver = "Always"
  Equation = "Heat Equation"
  Variable = "Temperature"
  Variable Dofs = 1
  Linear System Solver = "Iterative"
  Linear System Iterative Method = "BiCGStab"
  Linear System Max Iterations = 350
  Linear System Convergence Tolerance = 1.0e-08
  Linear System Abort Not Converged = True
  Linear System Preconditioning = "ILU0"
  Linear System Residual Output = 0
  Steady State Convergence Tolerance = 1.0e-05
  Stabilize = True
  Nonlinear System Convergence Tolerance = 1.0e-05
  Nonlinear System Max Iterations = 1
End

! The isoline of x=0.05 is a fixed vertical cut of the 2D mesh. Only the
! Temperature interpolated onto it changes from timestep to timestep.
!---------------------------------------------------------------------
Solver 2
  Exec Solver = "After Timestep"
  Equation = "isoline"
  Procedure = "Isosurface" "IsosurfaceSolver"

  IsoSurface Variable = "Coordinate 1"
  IsoSurface Values(1) = 0.05

  Isosurface Fixed = Logical True
  Isosurface Interpolant 1 = String "Temperature"

  Isomesh Output Active = Logical False
End

Material 1
  Name = "Material"
  Density = 1
  Heat Capacity = 1
  Heat Conductivity = 3
End

Body Force 1
  Name = "BodyForce"
  Heat Source = 1
End

Boundary Condition 1
  Name = "Constraint"
  Target Boundaries(1) = 1
  Temperature = 0
End

Solver 1 :: Reference Norm = 2.52595818E-02
Solver 2 :: Reference Norm = 7.43000000E+02
