Header
  CHECK KEYWORDS Warn
  Mesh DB "." "angle"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady State"
  Steady State Max Iterations = 1
  Output Intervals = 1
  Post File = "case.vtu"
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
End

Body 1
  Name = "Angle"
  Equation = 1
  Material = 1
End

Body 2
  Name = "Angle2"
  Equation = 2
  Material = 1
End

Equation 1 ::  Active Solvers(1) = 1
Equation 2 ::  Active Solvers(2) = 1 2

Solver 1
  Equation = "Stress Analysis"
  Variable = "Displacement"
  Variable Dofs = 2

  Eigen Analysis = True
  Eigen System Values = 12
  Eigen System Convergence Tolerance = Real 1.0e-6
  
  Linear System Symmetric = Logical True

  Linear System Solver = string "Iterative"
  Linear System Convergence Tolerance = real 1e-7
  Linear System Iterative Method = BiCGStabl
  BiCGStabl Polynomial Degree = 4
  Linear System Residual Output = integer 1
  Linear System Max Iterations = integer 2000
  Linear System Preconditioning = iLU
  Linear System Residual Output = 50

  Eigen System Select = smallest magnitude
  Solver Timing = Logical True
  Eigen System Shift = Real 1.0e3
End

Solver 2
  Equation = "S"
  Variable Dofs = 2

  Variable = "Potential"
  Variable Dofs = 2

  Procedure = "StressSolve" "StressSolver"

  Eigen Analysis = True
  Eigen System Values = 12
  Eigen System Convergence Tolerance = Real 1.0e-6
  
  Linear System Solver = string "Iterative"
  Linear System Convergence Tolerance = real 1e-8
  Linear System Iterative Method = BiCGStabL
  BiCGStabl Polynomial Degree = 4
  Linear System Residual Output = 1
  Linear System Preconditioning = ILU
  Linear System Residual Output = 10
  Linear System Max Iterations =  2000

  Eigen System Select = smallest magnitude
  Eigen System Shift = Real 1.0e3
  Solver Timing = Logical True
End


Solver 3
!  Exec Solver = after all
! Exec Solver = never
  Equation = "result output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = block
  Vtu Format = Logical True
  Single Precision = Logical True 

  Eigen Analysis = True
End


Solver 4
  Equation = "SaveScalars"
!  Filename = f.dat

  Procedure = "SaveData" "SaveScalars"
  Save EigenValues = True
!  Variable 1 = Displacement 1
!  Operator 1 = max abs 
!  Variable 2 = Displacement 2
!  Operator 2 = max abs 

  Show Norm Index = 1 
End


Material 1
  Name = "Structure"
  Density = 1000.0
  Youngs Modulus = 1.0e9
  Poisson Ratio = 0.3
End


Boundary Condition 1
  Name = "Left"
  Target Boundaries(1) = 2
  Displacement 1 = 0.0
  Displacement 2 = 0.0

  Potential 1 = 0
  Potential 2 = 0
End

Boundary Condition 2
  Name = "Right"
  Target Boundaries = 3
End 

Boundary Condition 3
  Name = "Else"
  Target Boundaries = 1
End 

Boundary Condition 4
  Name = "Else"
  Target Boundaries = 1
End 

Solver 4 :: Reference Norm = Real 4.713633565070E+004
RUN

