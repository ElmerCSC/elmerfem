! Regression test for "Stabilization Method = VMS" in IncompressibleNS: the
! residual-based variational multiscale terms (VMSTerms), the formulation of
! FlowSolve's VMS (test FlowSolveVMS) with the physical pressure as unknown.
!
! Manufactured solution in the unit cube, rho = 1.3, mu = 0.1, linear in
! space and time so that BDF and the trilinear element reproduce it exactly:
!   u = (1+t)*(y, z, x),  p = x,
!   f = du/dt + (u.grad)u + grad(p)/rho
!     = (y,z,x) + (1+t)^2*(z,x,y) + (1/rho,0,0)  (per unit mass).
! Transient BDF2 with Newton. Every term of the residual-based method vanishes
! on the exact solution, so the discrete one is exact to round-off: max|p|
! (SaveScalars) is exactly 1 -- the physical pressure (FlowSolve's VMS gives
! p/rho). On a lid-driven cavity (Re 1000, 20x20) this and FlowSolve's VMS
! agree to 2e-8.
! NB: MATC "^" binds looser than "*", hence the explicit (1+t)*(1+t).

Check Keywords Warn
Header
  Mesh DB "." "cube"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = 0.1
  Timestep Intervals = 3
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End
Initial Condition 1
  Velocity 1 = Variable Coordinate 2
    Real MATC "tx"
  Velocity 2 = Variable Coordinate 3
    Real MATC "tx"
  Velocity 3 = Variable Coordinate 1
    Real MATC "tx"
  Pressure = Variable Coordinate 1
    Real MATC "tx"
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Stabilization Method = vms
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 50
  Nonlinear System Convergence Tolerance = 1.0e-12
  Nonlinear System Newton After Iterations = 3
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Exec Solver = After Timestep
  Variable 1 = Pressure
  Operator 1 = max abs
  Show Norm Index = 1
End
Material 1
  Density = 1.3
  Viscosity = 0.1
End
Body Force 1
  Flow Bodyforce 1 = Variable Coordinate 1, Coordinate 2, Coordinate 3, Time
    Real MATC "tx(1)+(1+tx(3))*(1+tx(3))*tx(2)+1/1.3"
  Flow Bodyforce 2 = Variable Coordinate 1, Coordinate 2, Coordinate 3, Time
    Real MATC "tx(2)+(1+tx(3))*(1+tx(3))*tx(0)"
  Flow Bodyforce 3 = Variable Coordinate 1, Coordinate 2, Coordinate 3, Time
    Real MATC "tx(0)+(1+tx(3))*(1+tx(3))*tx(1)"
End
Boundary Condition 1
  Target Boundaries(6) = 1 2 3 4 5 6
  Velocity 1 = Variable Coordinate 2, Time
    Real MATC "(1+tx(1))*tx(0)"
  Velocity 2 = Variable Coordinate 3, Time
    Real MATC "(1+tx(1))*tx(0)"
  Velocity 3 = Variable Coordinate 1, Time
    Real MATC "(1+tx(1))*tx(0)"
End
Boundary Condition 2
  Target Coordinates(1,3) = 0.0 0.0 0.0
  Pressure = 0.0
End

Solver 1 :: Reference Norm = Real 7.96084166E-01
Solver 1 :: Reference Norm Tolerance = Real 1.0e-6
! max|p|
Solver 2 :: Reference Norm = Real 1.0
Solver 2 :: Reference Norm Tolerance = Real 1.0e-6
