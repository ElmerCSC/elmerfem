! As the test case VectorHelmholtzWaveguide4, except that the p-multigrid
! preconditioner is smoothed with "csgs" rather than "cjacobi". The point is to
! cover ComplexSGS in Smoothers.F90, which no other test case reaches: every
! other sif selecting csgs belongs to a test that does not launch it.
! The reference norms are those of VectorHelmholtzWaveguide4 -- the smoother
! only preconditions, so the converged solution must be the same.

Check Keywords "Warn"

Header
  Mesh DB "." "shoebox_prisms"
End

Simulation
  Max Output Level = 5

  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1

  Post File = prisms.vtu
  vtu: Ascii Output = True
  Output Intervals(1) = 1

  Mesh Levels = 1
End

Constants
End

Body 1
  Equation = 1
  Material = 1
End

$ beta0=41.9332032192090
$ k0=52.3961255469564
$ kc=31.4159265358979 
$ w=2*pi*(2.5e9)
$ mu0=4e-7*pi

Material 1
  Relative Permittivity = Real 1
End

Equation 1
  Active Solvers(2) = 1 2
  Angular Frequency = Real $w
End


Solver 1
  Equation = "VectorHelmholtz"

  Optimize Bandwidth = True
  Linear System Symmetric = False
  Procedure = "VectorHelmholtz" "VectorHelmholtzSolver"

  Linear System Abort not Converged = false

  Linear System Residual Output = 1
  Calculate Energy Inner Product = Logical True

  Linear System Complex = true

  ! csgs.sif switches to the second-order basis functions and solves the
  ! resulting system with a p-multigrid preconditioner smoothed by the complex
  ! symmetric Gauss-Seidel smoother.

  include csgs.sif

End

Solver 2
  Equation = "calcfields"

  Optimize Bandwidth = False
  Procedure = "VectorHelmholtz" "VectorHelmholtzCalcFields"
  Linear System Symmetric = False

  Calculate Elemental Fields = Logical True
  
  Calculate Magnetic Field Strength = Logical False
  Calculate Magnetic Flux Density = Logical False
  Calculate Poynting vector = Logical False
  Calculate Div of Poynting Vector = Logical False
  Calculate Electric field = Logical True
  Calculate Energy Functional = Logical True

  Steady State Convergence Tolerance = 1
  Linear System Solver = "Iterative"
  Linear System Preconditioning = None
  Linear System Residual Output = 10
  Linear System Max Iterations = 5000
  Linear System Iterative Method = CG
  Linear System Convergence Tolerance = 1.0e-9
End

Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  FileName = "f.dat"

  Variable 1 = E re
  Operator 1 = min
  Operator 2 = max
  Operator 3 = sum
  Variable 4 = E im
  Operator 4 = min
  Operator 5 = max
  Operator 6 = sum

  Show Norm Index = 7
End

Boundary Condition 1
  Name = "Inlet" ! y == 0 
  Target Boundaries(1) = 3

  Electric Robin Coefficient im = Real $ beta0

  Magnetic Boundary Load 3 = Variable Coordinate 1
    Real MATC "-2*beta0*k0/kc*sin(kc*tx)"
End

Boundary Condition 2
  Name = "OtherSides"
  Target Boundaries(5) = 1 2 4 5 6 

  !E re {e} = Real 0
  !E im {e} = Real 0

  Electric Robin Coefficient = Real $ -474315.9900340191 
  Electric Robin Coefficient im = Real $ 474315.9900340191  
End

Solver 1 :: Reference Norm = 2.18215267E-03
Solver 1 :: Reference Norm Tolerance = 1.0E-6
Solver 3 :: Reference Norm = 398785.93137342826
Solver 3 :: Reference Norm Tolerance = 1.0E-4
