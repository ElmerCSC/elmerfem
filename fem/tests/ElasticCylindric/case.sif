! ElasticSolve in "Cylindric Symmetric" coordinates.
!
! That coordinate system means axisymmetric with a swirling component. Neither
! elasticity solver has a degree of freedom for one -- a 2D run solves for u_r and
! u_z only, and LocalStress explicitly zeroes the torsional shears -- so here it is
! nothing but a synonym for "Axi Symmetric". StressSolve has always treated it as
! one; ElasticSolve used to reject it outright with "Unsupported coordinate
! system", which this guards against returning.
!
! Sifs do write it meaning plain axisymmetric: fem/tests/CylComAxi is a Code_Aster
! benchmark whose own header calls itself an axisymmetric presentation, and it
! declares Cylindric Symmetric.
!
! The reference norm below is exactly the value the identical case produces under
! "Axi Symmetric" -- that equality is the property being tested, not the number.
! Measured: cylindric 1.22591845E-05, axisymmetric 1.22591845E-05. Read as
! Cartesian instead it gives 1.17424771E-05, 4% away and far outside the tolerance,
! so the check is sensitive to the difference it is meant to catch.

Header
  Mesh DB "." "square"
End

Simulation
  Max Output Level = 4
  Coordinate System = Cylindric Symmetric
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 0
End

Body 1
  Equation = 1
  Material = 1
End

Material 1
  Youngs Modulus = 1.0e3
  Poisson Ratio = 0.3
  Density = 1.0
End

Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = "Elasticity"
  Procedure = "ElasticSolve" "ElasticSolver"
  Variable = -dofs 2 Displacement

  ! Small strain, so the case is a pure statement about the coordinate system.
  Large Deflection = False

  Calculate Stresses = True
  Calculate Strains = True
  Displace Mesh = False

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack

  Nonlinear System Max Iterations = 30
  Nonlinear System Convergence Tolerance = 1.0e-11
  Steady State Convergence Tolerance = 1.0e-9
End

! Only one edge is held, so the interior response depends on the operator and a
! Cartesian reading would show up in the norm.
Boundary Condition 1
  Target Boundaries(1) = 1
  Displacement 1 = Real 0.0
  Displacement 2 = Real 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 3
  Displacement 2 = Real 2.0e-5
End

Solver 1 :: Reference Norm = Real 1.22591845E-05
Solver 1 :: Reference Norm Tolerance = Real 1.0e-5
RUN
