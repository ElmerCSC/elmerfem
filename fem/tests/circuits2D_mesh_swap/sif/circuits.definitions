! One circuit: a current source driving the stranded coil of component 1.
! Nothing here is mesh dependent - the point of the test is that the structures
! built from these definitions have to be rebuilt when the mesh under them is
! replaced.
$ Circuits = 1

$ C.1.perm = zeros(4)
$ C.1.perm(0) = 0
$ C.1.perm(2) = 1
$ C.1.perm(3) = 2
$ C.1.perm(1) = 3

$ C.1.variables = 4
$ C.1.A = zeros(4,4)
$ C.1.B = zeros(4,4)
$ C.1.Mre = zeros(4,4)
$ C.1.Mim = zeros(4,4)

$ C.1.name.1 = "i_testsource"
$ C.1.name.2 = "v_testsource"
$ C.1.name.3 = "i_component(1)"
$ C.1.name.4 = "v_component(1)"

$ C.1.B(0,0) = 1
$ C.1.source.1 = "testsource"

$ C.1.B(1,1) = 1
$ C.1.B(1,3) = 1
$ C.1.B(2,0) = 1
$ C.1.B(2,2) = -1
