! Parallel version of circuits2D_harmonic_stranded: the same axisymmetric
! stranded-coil case, run on 1 and 2 partitions with identical reference norms.
!
! The point of the test is the parallel-only code in the circuit package, which
! nothing else in the suite covers:
!   - SetCircuitsParallelInfo(), i.e. the RowOwner / NeighbourList setup for the
!     circuit rows of the constraint matrix (also the "C.1.perm" branch, since
!     this case sets a permutation vector),
!   - the "Cvar % Owner /= ParEnv % myPE" row filters in the matrix structure
!     pass and in the assembly,
!   - ParallelReduction() of Comp % Resistance - no "Resistance" keyword is
!     given, so it is integrated over the coil elements and summed over the
!     partitions, and it is checked below through r_component(1),
!   - ParallelReduction() in ComputeElectrodeArea() - no "Electrode Area" is
!     given either, so the coil area is summed over the partitions and feeds
!     N_j, hence the whole coupling,
!   - the MPI_ALLREDUCE gathering of the circuit variables in CircuitsOutput().
!
! Solved iteratively rather than with UMFPACK so that the parallel run needs no
! direct solver. Note "Nonlinear System Consistent Norm": without it the norm is
! picked up at a different point of the nonlinear loop in parallel and the
! reference norms do not carry over between 1 and 2 partitions.
!
! Author: Eelis Takala, Trafotek Oy (original serial case, October 2015)
! eelis.takala@trafotek.fi

Check Keywords "Warn"
INCLUDE sif/1381-circuits-components.definitions
INCLUDE 1381/mesh.names

Header 1
   Mesh DB "." "1381"
End

Simulation 1
   Max Output Level = 3
   Coordinate System = Axi symmetric
   Simulation Type = Steady
   Steady State Max Iterations = 1
   Angular Frequency = 314.159265359
End

Solver 1
   Exec Solver = Before All
   Procedure = "Poisson" "PoissonSolver"
   Linear System Solver = Iterative
   Linear System Iterative Method = CG
   Linear System Max Iterations = 1000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Preconditioning = ILU0
   Linear System Abort Not Converged = True
   Linear System Residual Output = 100
   Equation = Direction
   Variable = -nooutput Alpha
End

Solver 2
   Exec Solver = Always
   Equation = Circuits
   Variable = X
   No Matrix = Logical True
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamicsHarmonic"
End

Solver 3
   Equation = "Mag"
   Variable = A[A re:1 A im:1]
   Procedure = "MagnetoDynamics2D" "MagnetoDynamics2DHarmonic"
   Linear System Symmetric = True
   NonLinear System Relaxation Factor=1
   Nonlinear System Consistent Norm = True
   Export Lagrange Multiplier = Logical True
   Linear System Solver = Iterative
   Linear System Iterative Method = BicgstabL
   Linear System Preconditioning = Circuit
   Linear System ILU Order = Integer 2
   BicgStabL Polynomial Degree = 4
   Linear System Complex = Logical True
   Linear System Convergence Tolerance = 1.e-10
   Linear System Max Iterations = 3000
   Linear System Residual Output = 1000
   Linear System Abort not Converged = True
   Steady State Convergence Tolerance = 1e-06
End

Solver 4
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End

! Asserts the circuit results themselves rather than only the field norm.
! "r_component(1)" is integrated over the coil elements and summed with
! ParallelReduction(), so it is a direct check that the reduction is right and
! that no partition either misses or double counts its elements.
Solver 5
   Exec Solver = After All
   Equation = "sv"
   Procedure = "SaveData" "SaveScalars"
   Filename = 1381/dat/1381.dat
   Show Norm Name = String "res: r_component(1)"
End

Equation 1
   Active Solvers(2) = 2 3
End

Equation 2
   Active Solvers(3) = 1 2 3
End

Material 1
   Name = iron
   Electric Conductivity = 0
   Relative Permeability = 2000
End

Material 2
   Name = air
   Electric Conductivity = 0
   Relative Permeability = 1
End

Material 3
   Name = aluminium
   Relative Permeability = 1
   Electric Conductivity = 1e7
End

Body 1
   Name = Core
   Target Bodies(6) = 1 2 3 4 5 6
   Equation = 1
   Material = 1
End

Body 2
   Name = air
   Target Bodies(2) = 9 7
   Equation = 1
   Material = 2
End

Body 3
   Name = test 1
   Target Bodies = 8
   Equation = 2
   Material = 3
End

Component 1
   Name = String test inductor
   Master Bodies = Integer 3
   Coil Type = String stranded
   Number of Turns = Real 1000
End

Component 2
   Name = String test inductor 2
   Component Type = String Resistor
End

Component 3
   Name = String test inductor 2
End

Body Force 1
   Name = "Circuit"
   testsource Re = Real 1.41421356237
   testsource Im = Real 0.0
End

Boundary Condition 1
   Target Boundaries(4) = $ center0 center1 center2 center3
   A re = Real 0
   A im = Real 0
End

Boundary Condition 2
   Target Boundaries(2) = 4 6
   Name = "Air Gap"
   Air Gap = logical True
   Air Gap Length = Real 0.0001
   Air Gap Relative Permeability = Real 1
End

Boundary Condition 3
   Target Boundaries(7) = 10 13 14 17 18 19 27
   Infinity BC = Logical True
End

Solver 3 :: Reference Norm = 2.50015518E-03
Solver 5 :: Reference Norm = 1.57079633E+01


