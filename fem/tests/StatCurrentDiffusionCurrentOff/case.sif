! Feature-OFF control for ../StatCurrentDiffusionCurrent.
!
! Same mesh, same three species, same material, same boundary data.  The ONLY
! difference is that Solver 4 does not opt in to the diffusion current, so the
! solver must return the ohmic answer -- identically zero, because both pinned
! ends are at zero potential -- and must therefore MISS the manufactured field
! by roughly its peak.
!
! This directory exists because the manufactured test alone cannot fail for the
! right reason: a solver that silently ignored the new term would still satisfy
! "total current cancels" (zero cancels trivially).  The pair does the work.

Check Keywords Warn

Header
  Mesh DB "." "strip"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Output Intervals = 1
End

Constants
  Faraday Constant = Real 96485.33212
End

Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Equation 1
  Active Solvers(5) = 1 2 3 4 5
End

! These inactive scalar solvers register the prescribed species variables.
Solver 1
  Exec Solver = Never
  Equation = "C1 storage"
  Variable = "C1"
  Variable DOFs = 1
  Procedure = "Poisson" "PoissonSolver"
End

Solver 2
  Exec Solver = Never
  Equation = "C2 storage"
  Variable = "C2"
  Variable DOFs = 1
  Procedure = "Poisson" "PoissonSolver"
End

Solver 3
  Exec Solver = Never
  Equation = "C3 storage"
  Variable = "C3"
  Variable DOFs = 1
  Procedure = "Poisson" "PoissonSolver"
End

Solver 4
  Equation = "Static current, ohmic only"
  Variable = "Potential"
  Variable DOFs = 1
  Procedure = "StatCurrentSolve" "StatCurrentSolver"

  ! THE ONE DIFFERENCE: no `Diffusion Current Species`, no
  ! `Diffusion Current Variable i`.  Everything else matches the sibling case.
  Calculate Volume Current = Logical True

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 1
  Steady State Convergence Tolerance = 1.0e-12
End

Solver 5
  Equation = "Manufactured solution check"
  Procedure = "MMSCheck" "CheckDiffusionCurrentMMS"


  ! Solver 4 declares no species here, so the checker is told which fields make
  ! up the manufactured potential it must demonstrate the ohmic solve MISSES.
  ! Same keyword name as the real contract, read from this section instead.
  Diffusion Current Variable 1 = String "C1"
  Diffusion Current Variable 2 = String "C2"
  Diffusion Current Variable 3 = String "C3"
End

Material 1
  Electric Conductivity = Real 19.903500454680898
  C1 Diffusivity = Real 1.0e-9
  C1 Ion Charge = Real 1
  C2 Diffusivity = Real 2.0e-9
  C2 Ion Charge = Real 1
  C3 Diffusivity = Real 1.5e-9
  C3 Ion Charge = Real -1
End

Initial Condition 1
  C1 = Variable Time
    Real Procedure "Profiles" "C1Profile"
  C2 = Variable Time
    Real Procedure "Profiles" "C2Profile"
  C3 = Variable Time
    Real Procedure "Profiles" "C3Profile"
End

Boundary Condition 1
  Target Boundaries(2) = 2 4
  Potential = 0.0
End

! The ohmic solution of a Laplace problem pinned to zero at both ends is
! identically zero, so the norm is zero and the comparison must be absolute.
Solver 4 :: Reference Norm = Real 0.0
Solver 4 :: Reference Norm Absolute = Logical True
Solver 4 :: Reference Norm Tolerance = Real 1.0e-12
