! Simple test case for StructuredMeshMapper
! As the test case "structmap" but with p:2 elements
!
! 30.3.2016 P.R. 

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "box"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady State"
  Steady State Max Iterations = 1
  Output Intervals = 1

  Serendipity P elements = False
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
End

Body 1
  Name = "Body1"
  Body Force = 1
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equation1"
  Heat Equation = True
End

Solver 1
  Equation = "Heat Equation"
! This test only runs HeatSolveVec, but its comment history is worth
! keeping: the previously-relaxed tolerance here (~4.2e-4 in the Solver 1
! norm, ~3.7e-4 in Solver 3) was compensating for a genuine bug in legacy
! HeatSolve.F90, not a HeatSolveVec discretization quirk.
!
! Legacy's DiffuseConvectiveCompose only grew its local assembly past the
! n corner-node DOFs (NBasis) when a convection term was present -- so a
! declared "Element = p:2" with no convection (this test's case, and any
! pure-diffusion p-refined problem) had its edge/bubble DOFs assembled
! with an all-zero matrix row: singular, confirmed by a Direct-solver NaN.
! BiCGStab+ILU0 quietly left those DOFs at their zero initial guess
! instead of diverging, returning a plausible-looking but only
! corner-accurate (not truly p:2) answer -- which is where the ~4e-4 gap
! from HeatSolveVec's (correctly p:2) result came from.
!
! Fixed in DiffuseConvectiveAnisotropic.F90 / DiffuseConvectiveGeneralAnisotropic.F90:
! NBasis now becomes the element's true DOF count whenever it's an active
! p-element with nd > n, independent of convection. Verified: legacy now
! matches HeatSolveVec's norm here to ~1e-9 relative, under both the
! iterative solver this test uses and a Direct solver (no longer NaNs).
  Procedure = "HeatSolveVec" "HeatSolver"
  Variable = "Temperature"
  Variable Dofs = 1
  Linear System Solver = "Iterative"
  Linear System Iterative Method = "BiCGStab"
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-08
  Linear System Abort Not Converged = True
  Linear System Preconditioning = "ILU0"
  Linear System Residual Output = 1
  Steady State Convergence Tolerance = 1.0e-05
  Stabilize = False  
  Nonlinear System Max Iterations = 1

  Element = p:2
End

Solver 2 
  Exec Solver = before all 
  Equation = "MapCoordinate"
  Procedure = "StructuredMeshMapper" "StructuredMeshMapper"
  Active Coordinate = Integer 2

!  Mapping Mask Variable = String "Temperature"
!  Bottom Surface Level = Real -1.0  
End 

Solver 3
  Exec Solver = after all 
  Equation = "MaxTemp"
  Procedure = "SaveData" "SaveScalars"

  Variable 1 = Temperature 
  Operator 1 = max
  Show Norm Index = 1
End 

Solver 4
!  Exec Solver = never
  Equation = "result output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = case
  Vtu Format = Logical True	
  !
  ! Use high-order Lagrange interpolation to visualize the solution:
  !
  Lagrange Element Degree = Integer 2
  Save Geometry Ids = True
End

Material 1
  Name = "Material1"
  Density = 1
  Heat Conductivity = 1
End

Body Force 1
  Name = "BodyForce1"
  Heat Source = 1
End

Boundary Condition 1
  Name = "bottom"
  Target Boundaries = 1 
  Bottom Surface = Variable "Coordinate 1"
     Real MATC "0.1*cos(5*tx)"
  Temperature = 0
End

Boundary Condition 2
  Name = "right"
  Target Boundaries = 2 
  Temperature = 0
End

Boundary Condition 3
  Name = "top"
  Top Surface = Variable "Coordinate 1"
    Real MATC "1+0.1*sin(5*tx)"
  Target Boundaries = 3 
  Temperature = 0
End

Boundary Condition 4
  Name = "left"
  Target Boundaries = 4 
  Temperature = 0
End

Solver 1 :: Reference Norm = 3.75004192E-02
Solver 1 :: Reference Norm Tolerance = 1.0e-3
Solver 3 :: Reference Norm = 1.20988151E-01
Solver 3 :: Reference Norm Tolerance = 1.0e-3
