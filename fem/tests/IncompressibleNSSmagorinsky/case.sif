! Regression test for "Viscosity Model = Smagorinsky" in IncompressibleNS
! (EffectiveViscosityVec): mu = mu0 + rho*C*h^2*sqrt(2*ss)/2, h the element
! diameter, C = "Smagorinsky Constant" -- the formula of MaterialModels.F90.
!
! Lid-driven cavity, Re = 1000, 20x20 quads, default bubbles, Newton. Checks
! made when this was added: Newton and Picard converge to the same solution
! (1e-8; Newton 10 iterations, Picard 43), the eddy viscosity changes the flow
! by 0.3 in max|u| against the laminar run, and FlowSolve on the same case
! (test FlowSolveSmagorinsky) agrees to 3e-3 in max|u| -- closer than the two
! solvers' different bubble spaces give for the laminar case (2e-2).
! Pressure is checked separately (max|p| by SaveScalars).

Check Keywords Warn
Header
  Mesh DB "." "cavity"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 300
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = Pressure
  Operator 1 = max abs
  Show Norm Index = 1
End
Material 1
  Density = 1.0
  Viscosity = 1.0e-3
  Viscosity Model = Smagorinsky
  Smagorinsky Constant = 0.1
End
Boundary Condition 1
  Target Boundaries(3) = 1 2 4
  Velocity 1 = 0
  Velocity 2 = 0
End
Boundary Condition 2
  Target Boundaries(1) = 3
  Velocity 1 = 1
  Velocity 2 = 0
End
Boundary Condition 3
  Target Coordinates(1,2) = 0.5 0.0
  Pressure = 0.0
End

Solver 1 :: Reference Norm = Real 2.11081789E-01
Solver 1 :: Reference Norm Tolerance = Real 1.0e-5
! max|p|
Solver 2 :: Reference Norm = Real 1.26201028E+00
Solver 2 :: Reference Norm Tolerance = Real 1.0e-5
