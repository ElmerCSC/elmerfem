! Circuit definitions of the first circuit solver.
! Everything sits behind the "ca" MATC namespace, which the solver is told about
! with "Circuit Namespace = String ca".
$ ca.Circuits = 1

$ ca.C.1.perm = zeros(4)
$ ca.C.1.perm(0) = 0
$ ca.C.1.perm(2) = 1
$ ca.C.1.perm(3) = 2
$ ca.C.1.perm(1) = 3

$ ca.C.1.variables = 4
$ ca.C.1.A = zeros(4,4)
$ ca.C.1.B = zeros(4,4)
$ ca.C.1.Mre = zeros(4,4)
$ ca.C.1.Mim = zeros(4,4)

$ ca.C.1.name.1 = "i_sourcea"
$ ca.C.1.name.2 = "v_sourcea"
$ ca.C.1.name.3 = "i_component(1)"
$ ca.C.1.name.4 = "v_component(1)"

$ ca.C.1.B(0,0) = 1
$ ca.C.1.source.1 = "sourcea"

$ ca.C.1.B(1,1) = 1
$ ca.C.1.B(1,3) = 1
$ ca.C.1.B(2,0) = 1
$ ca.C.1.B(2,2) = -1
