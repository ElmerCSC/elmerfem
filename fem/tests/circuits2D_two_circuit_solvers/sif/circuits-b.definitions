! Circuit definitions of the second circuit solver.
! Everything sits behind the "cb" MATC namespace, which the solver is told about
! with "Circuit Namespace = String cb".
$ cb.Circuits = 1

$ cb.C.1.perm = zeros(4)
$ cb.C.1.perm(0) = 0
$ cb.C.1.perm(2) = 1
$ cb.C.1.perm(3) = 2
$ cb.C.1.perm(1) = 3

$ cb.C.1.variables = 4
$ cb.C.1.A = zeros(4,4)
$ cb.C.1.B = zeros(4,4)
$ cb.C.1.Mre = zeros(4,4)
$ cb.C.1.Mim = zeros(4,4)

$ cb.C.1.name.1 = "i_sourceb"
$ cb.C.1.name.2 = "v_sourceb"
$ cb.C.1.name.3 = "i_component(2)"
$ cb.C.1.name.4 = "v_component(2)"

$ cb.C.1.B(0,0) = 1
$ cb.C.1.source.1 = "sourceb"

$ cb.C.1.B(1,1) = 1
$ cb.C.1.B(1,3) = 1
$ cb.C.1.B(2,0) = 1
$ cb.C.1.B(2,2) = -1
