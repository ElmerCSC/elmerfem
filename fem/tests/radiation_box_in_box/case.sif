! Test case for beam-like radiator heat sources
! - four 1d radiators within a box
! - total flux (1000) summed up for reference
! - radiaosity model used for speed
! - shading elements are combined for faster VF computation
!
! J.R. & P.R. 16.6.2026
 
Check Keywords Warn

Header
  Mesh DB "." "box_in_box"
End

Constants
  Stefan Boltzmann = 5.67e-8
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Post File = case.vtu
  Ascii Output = True
End

Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Body 2
  Equation = 1
  Material = 1
  Initial Condition = 1
  Body Force = 1
End

Initial Condition 1
  Temperature = 300.0
End


Body Force 1
  Name = "RotateInner"
  Mesh Rotate 1 = Real 15.0
  Mesh Rotate 3 = Real 30.0
  Moving Body = Logical True
End 


Material 1
  Density = 1.0
  Heat Conductivity = 1.0
  Emissivity = 0.8
End


Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolveVec" "HeatSolver"

  Variable = Temperature

  Linear System Solver = Iterative
  Linear System Iterative Method = idrs 

  Linear System Convergence Tolerance = 1.0e-8
  Linear System Max Iterations = 1000
  Linear System Residual Output = 10
  Linear System Preconditioning = ILU1

  Nonlinear System Newton After Tolerance = 0.0
  Nonlinear System Newton After Iterations = 5
  Nonlinear System Max Iterations = 50
  Nonlinear System Convergence Tolerance = 1.0e-6

  Steady State Convergence Tolerance = 1.0e-8

! These relaxation factors are essential for optimal convergence
  Nonlinear System Relaxation Factor = 0.4
  Radiosity Newton Relaxation Factor = 0.8

! Spell out how the view factors are resolved, so this test keeps exercising
! the path it was blessed against even if the defaults change.

! Viewfactor Closed Form Integration : the inner ("to area") integral,
!     closed form (exact for planar patches) or Gauss quadrature
!
! Viewfactor Shadowing               : "ray casting" or "clipping"

  Viewfactor Closed Form Integration = Logical False
  Viewfactor Shadowing = String "ray casting"

  Viewfactor raytrace tolerance = 0.001
  Viewfactor area tolerance = 0.01
  Viewfactor factor tolerance = 0.001
  Viewfactor number Of Rays = 8

  Viewfactor binary Output = True
  Viewfactor Single Precision = True 

! There are two ways to define a coarser shading mesh
! 1) combining elements internally using some logic (better)
  Viewfactor combine elements = Logical True

! 2) using user defined coarser mesh 
!  Viewfactor Volume Shadow Mesh = String "box_in_box_coarse"

! The BBox is by default eliminated from the shading. If you want to
! make the code slower, activate this. 
! Viewfactor BBox Shadow = Logical True

  Radiosity Model = Logical True

  radiation: Linear System Solver = Iterative
  radiation: Linear System Residual Output = 1
  radiation: Linear System Convergence Tolerance = 1.0e-8

  Solver Timing = True
  Calculate Loads = True
End


Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"

  Variable 1 = Temperature
  Operator 1 = max

  Save Coordinates(4,3) = Real \
          -1.0 0.0 -0.75 \
           1.0 0.0 -0.25 \
           0.0 1.0 0.25 \
           0.0 -1.0 0.75 

  Filename = f.dat
  Show Norm Name = "max: temperature"
End


Solver 3
  Equation = SaveScalars2
  Procedure = "SaveData" "SaveScalars"

  Variable 1 = Temperature Loads
  Operator 1 = boundary sum
  Mask Name 1 = TotFlux 

  Filename = g.dat
  Show Norm Index = 1
End


! Rotate the rotor & compute the mesh velocity for ALE
Solver 4
  Equation = MeshRotate
  Procedure = "RigidMeshMapper" "RigidMeshMapper"
  Exec Solver = "When Created"

! This tells the viewfactor computation to run this for mesh mapping
  Viewfactor Mapping Solver = True
End 


Equation 1
  Active Solvers(2) = 1 4
End


Boundary Condition 1
  Name = "Bot And Top"
  Target Boundaries(2) = 4 9

  Temperature = 300.0
  TotFlux = Logical True
End

Boundary Condition 2
  Name = "BigCube-Sides"
  Target Boundaries(1) = 1

  External Temperature = 300.0
  Heat Transfer Coefficient = 1.0

! We set a flag to sum up nodal heat fluxes from the outer boundary.
! It should sum up to 1000!
  TotFlux = Logical True
End

Boundary Condition 3
  Name = "BigCube-Internal"
  Target Boundaries(3) = 2 5 8 

  Radiator BC = Logical True
  Radiation Target Body = -1

! You can run the test case with just radiators or also including radiation heat transfer between boundaries.
  Radiation = Diffuse Gray
End

Boundary Condition 4
  Name = "SmallCube-External"
  Target Boundaries(3) = 3 6 7 

  Radiator BC = Logical True
  Radiation Target Body = -1

  Radiation = Diffuse Gray
End



Body Force 1
  Name = "Radiate"

! These four polylines with two sets of coordinates define the 1D cylindrical heating elements. 
  Radiator Coordinates(4,6) = Real \
          -0.75 0.0 -0.75 -0.85 0.0 -0.75  \
           0.75 0.0 -0.25 -0.85 0.0 -0.25  \
           0.0 0.75  0.25 -0.0 0.85 0.25 \
           0.0 -0.75 0.75 -0.0 -0.85 0.75

! These define the total heating power of the heating elements.
  Radiator Power 1 = Real 1.0e2
  Radiator Power 2 = Real 2.0e2
  Radiator Power 3 = Real 3.0e2
  Radiator Power 4 = Real 4.0e2
End


Solver 1 :: Reference Norm = 3.12175465E+02
Solver 1 :: Reference Norm Tolerance = 1.0e-4
Solver 2 :: Reference Norm = 3.43931061E+02
Solver 2 :: Reference Norm Tolerance = 1.0e-4
! This should be 1000 exact, if fully converged.
Solver 3 :: Reference Norm = 9.99957133E+02

