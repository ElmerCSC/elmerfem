! ElasticIncompressible in three dimensions, and with a quadratic displacement
! instead of a bubble: the pressure is restricted to the lowest-order basis by the
! formulation itself, so "Element = p:2" gives a stable pair the same way "p:1 b:3"
! does in the plane. Both solvers, one problem, one reference value.
!
! Why the element matters here rather than being a detail: an EQUAL order pair is
! unstable, and the two solvers then disagree wildly -- 117.6 against 40.5 on the
! plane case with the bubble removed -- because the discrete pressure has a null
! space and a direct solve returns whichever member of it the round-off points at.
! Neither answer is wrong; the element is. So a cross-solver test of this
! formulation is only meaningful on a stable pair, which is worth knowing before
! reading a disagreement here as a defect.
!
! The load is sheared in two directions at once, so the constraint is not satisfied
! by any one component alone.

Header
  Mesh DB "." "cube"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
  Material = 1
End

! As in the plane case, the ratio must not reach the answer: mu is E/3.
Material 1
  Density = Real 0
  Youngs Modulus = Real 1
  Poisson Ratio = Real 0.1
End

Equation 1
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "Stress Analysis"
  Procedure = "StressSolve" "StressSolver"
  Variable = String "sSol[sDisp:3 sPres:1]"
  Element = p:2
  Incompressible = Logical True
  Displace Mesh = Logical False

  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK

  Nonlinear System Convergence Tolerance = 1.0e-9
  Nonlinear System Max Iterations = 30
  Steady State Convergence Tolerance = 1.0e-8
End

Solver 2
  Equation = "Elasticity Analysis"
  Procedure = "ElasticSolve" "ElasticSolver"
  Variable = String "eSol[eDisp:3 ePres:1]"
  Element = p:2
  Incompressible = Logical True
  Large Deflection = False
  Displace Mesh = Logical False

  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK

  Nonlinear System Convergence Tolerance = 1.0e-9
  Nonlinear System Max Iterations = 30
  Steady State Convergence Tolerance = 1.0e-8
End

Boundary Condition 1
  Target Boundaries(1) = 1
  sDisp 1 = Real 0
  sDisp 2 = Real 0
  sDisp 3 = Real 0
  eDisp 1 = Real 0
  eDisp 2 = Real 0
  eDisp 3 = Real 0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Force 1 = Real 0.1
  Force 2 = Real 0.05
End

Solver 1 :: Reference Norm = Real 4.56405287E-02
Solver 2 :: Reference Norm = Real 4.56405287E-02
