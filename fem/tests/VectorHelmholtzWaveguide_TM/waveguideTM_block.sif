!
! A wave guide model for a transverse magnetic (TM) solution
!
! The case is defined such that the time-harmonic solution is expected to be of
! the form
!
! E = (cos(k_1 x), 0, -ik_1/k_3 sin(k_1 x)) E_0 exp[-i(w t - k_3 z)] 
!
! The case script of this file uses the parameters k_1 = kc and k_3 = beta0.
!
! Differences with respect to the original case are that the second-order basis
! is used and block preconditioning is used.

Check Keywords "Warn"

Header
Mesh DB "." "shoebox_tets"
End

Simulation
  Max Output Level = 5

  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1

  !Post File = vectorhelmholtz.vtu
  Output Intervals(1) = 1
!  Mesh Levels = 2
End

Constants
!Permeability of Vacuum = Real 1
!Permittivity of Vacuum = Real 1
End

Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

$ mu0 = 4e-7*pi
$ eps0 = 8.854187817e-12
$ c = 1/sqrt(mu0*eps0)
$ n = 1
$ a = 0.1   ! The distance of parallel planes
$ w = 2*pi*(2.5e9)
$ k0 = w/c
$ kc = n*pi/a
$ beta0 = sqrt(k0^2-kc^2)
$ s = -1.0

! The above parameters give the following numerical values: 
!
! $ k0=52.3961255469564
! $ beta0=41.9332032192090 
! $ kc=31.4159265358979 

Material 1
  Relative Permittivity = Real 1
  !Relative Permittivity im = Real 0
End

Equation 1
  Active Solvers(2) = 1 2
  Angular Frequency = Real $w
End

Solver 1
  Equation = "VectorHelmholtz"
  Use Piola Transform = True
  Second Kind Basis = True
  Quadratic Approximation = True

  Procedure = "VectorHelmholtz" "VectorHelmholtzSolver"

  Linear System Symmetric = False
  Linear System Residual Mode = True

  Linear System Block Mode = True
  Block Quadratic Hcurl System = Logical True
  Block Quadratic Hcurl Pick Simplest = Logical True
  Block Preconditioner = True
  Block Gauss-Seidel = True
  Block Scaling = True

! Linear system solver for outer loop
!-----------------------------------------
  Outer: Linear System Solver = "Iterative"
  Outer: Linear System Convergence Tolerance = 1e-7
  Outer: Linear System Iterative Method = gcr
  Outer: Linear System Max Iterations = 50
  Outer: Linear System Residual Output = 1
  Outer: Linear System GCR Restart = 50
  Outer: Linear System Abort Not Converged = False
  Outer: Linear System Pseudo Complex = True

!  $blocktol = 0.01

! Linear system solver for DOFs corresponding to
! the lowest-order Nedelec basis:
!-----------------------------------------
  block 11: Linear System Solver = "direct"
  block 11: Linear System direct method = umfpack ! "mumps"
  block 11: Linear System Complex = True
  block 11: Linear System Scaling = True
  block 11: Linear System Abort Not Converged = False

! Linear system solver for DOFs corresponding to
! the hierarchic augmentation:
!-----------------------------------------
!  block 22: Linear System Solver = "direct"
!  block 22: Linear System direct method = umfpack ! "mumps"
  block 22: Linear System Solver = "Iterative"
  block 22: Linear System Convergence Tolerance = 1e-8
  block 22: Linear System Iterative Method = IDRS !GCR
!  block 22: BiCGstabl polynomial degree = Integer 8
!  block 22: Linear System GCR Restart = 100
  block 22: Linear System Preconditioning = diagonal
  block 22: Linear System Residual Output = 10
  block 22: Linear System Max Iterations = 400
  block 22: Linear System Complex = True
  block 22: Linear System Abort Not Converged = False
  block 22: Linear System Scaling = True

  Steady State Convergence Tolerance = 1e-09
  Calculate Loads = Logical True
  Calculate Energy Inner Product = Logical True
End

Solver 2
  Equation = "calcfields"

  Procedure = "VectorHelmholtz" "VectorHelmholtzCalcFields"

  Calculate Elemental Fields = True
  Calculate Magnetic Field Strength = Logical True
  Calculate Magnetic Flux Density = Logical True
  !Calculate Poynting vector = Logical True
  !Calculate Div of Poynting Vector = Logical True
  Calculate Electric field = Logical True
  Calculate Energy Functional = Logical True

  Steady State Convergence Tolerance = 1
  Linear System Solver = "Iterative"
  Linear System Preconditioning = None
  Linear System Residual Output = 10
  Linear System Max Iterations = 5000
  Linear System Iterative Method = CG
  Linear System Convergence Tolerance = 1.0e-9
End

Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  FileName = "scalar_values.dat"
End

Solver 4
!  Exec Solver = never
  !Equation = VtuOutput
  Equation = "result output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = TM_2ndkind_test
  Vtu Format = Logical True
  Ascii Output = True
  !GMSH Format = Logical True
  !Single Precision = Logical True
  !Save Bulk Only = True
  Discontinuous Bodies = True
End 

Boundary Condition 1
  Target Boundaries(1) = 1
  Electric Robin Coefficient Im = Real $ -s*k0*k0/beta0
  Magnetic Boundary Load Im 1 = Variable Coordinate 1
    Real MATC "(1-s)*k0*k0/beta0*cos(kc*tx)"
End

Boundary Condition 2
  Target Boundaries(2) = 2 4	
  E re {e} = Real 0
  E im {e} = Real 0
End

Boundary Condition 3
  Target Boundaries(1) = 6
  !
  ! An absorbing BC for the TM case:
  !  
  Electric Robin Coefficient im = Real $ k0*k0/beta0  
End


! + the do-nothing BC on the boundaries 2 and 5 to set n x curl E = 0 


Solver 1 :: Reference Norm = 1.41792461E-03
Solver 1 :: Reference Norm Tolerance = 1e-4
Solver 2 :: Reference Norm = 3.45565271E-01
Solver 2 :: Reference Norm Tolerance = 1e-4
