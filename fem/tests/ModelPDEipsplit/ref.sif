! This is a test case for IP-dependent material parameter with adaptive
! gauss integration scheme using large number of IP points for interface elements. 
!
! P.R. 1.4.2026

$width=1.0e-6

Check Keywords "Warn"

Header :: Mesh DB "." "square"

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State

  Output Intervals(1) = 1
  Steady State Max Iterations = 1

  Post File = "ref.vtu"
  ascii output = true

  Mesh Levels = 2
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End

! select r0 such that the area of circle is 2. 
$r0=sqrt(2/pi)
Initial Condition 1
!LS = Variable "Coordinate"
!   Real MATC "r0^2-tx(0)^2-tx(1)^2"

! This linear tests should enable exact areas. 
  LS = Variable "Coordinate"
   Real MATC "tx(0)+0.1*tx(1)"
End 

Material 1
  Diffusion coefficient = 1.0
End

Body Force 1
  Field Source At Ip = Logical True
  Field Source =  Variable "LS"
    Real
      -1 0.0
      -$width$ 0.0
       $width$ 1.0
       1 1.0      
    End 
End 

Equation 1
  Active Solvers(1) = 1
End 

$np=5^2

Solver 1
  Equation = "ModelPDE"
  Variable = "Field"
  Procedure = "ModelPDEhandle" "AdvDiffSolver"

  Nonlinear System Max Iterations = 1

  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
  Linear System Residual Output = 10

! This adds more integration points if the values of "LS" are within the narrow band
  Adaptive Integration Variable = String "LS"
  Adaptive Integration Lower Limit = Real $-width
  Adaptive Integration Upper Limit = Real $width
  Adaptive Integration Points = Integer $np

  Nonlinear Update Exported Variables = True
  Exported Variable 1 = LS

  Calculate Loads = True

! Activate integration test in ModelPDE
  Integ Test = Logical True
End


Solver 2
  Equation = "CheckSum"
  Procedure = "SaveData" "SaveScalars"

  Variable 1 = "Field loads"
  Operator 1 = sum

  Expression 1 = $pi*0.5^2
  Expression 2 = $np

  Filename = r.dat
  File Append = True
  Show Norm Index = 1
End 

Boundary Condition 1
  Name = "All"
  Target Boundaries(4) = 1 2 3 4
  Field = Real 0.0  
End

Solver 1 :: Reference Norm = 8.05605871E-02
! This presents the area of the square. 
Solver 2 :: Reference Norm = 2.00211730E+00
