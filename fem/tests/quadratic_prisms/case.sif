!--------------------------------------------------------------------
! A test case quadratic prisms.
!
! M.M. & P.R. / 30.3.2026
!--------------------------------------------------------------------

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "prisms"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 10
  Coordinate System = "Cartesian"

  Simulation Type = "Steady State"
  Steady State Max Iterations = 1

  Output Intervals = 0
  Post File = "case.vtu"
  vtu: ascii output = true
End


Body 1
  Name = "Ideal"
  Equation = 1
  Material = 1
  Body Force = 1
End

Equation 1
  Name = "Heat"
  Active Solvers(1) = 1
End


Body Force 1 
  Name = "Heating"
!  Heat Source = 1.0  
End 


Solver 1
  Equation = "Heat"
  Variable = "Temperature"
  Procedure = "HeatSolveVec" "HeatSolver"

  Linear System Solver = "Direct"
  Linear System Direct Method = "umfpack"
  Nonlinear System Max Iterations = 1
End


Material 1
  Name = "Ideal"
  Density = 1.0
  Heat Conductivity = 1.0
End


Boundary Condition 1
  Name = "Bot"
  Target Boundaries(1) = 1
  Temperature = 0
End


Boundary Condition 2
  Name = "Side1"
  Target Boundaries(1) = 2
End

Boundary Condition 3
  Name = "Side2"
  Target Boundaries(1) = 3
End

Boundary Condition 4
  Name = "Side3"
  Target Boundaries(1) = 4
End

Boundary Condition 5
  Name = "Side4"
  Target Boundaries(1) = 5
End

Boundary Condition 6
  Name = "Top"
  Target Boundaries(1) = 6

  Heat Transfer Coefficient = 1.0
  External Temperature = Variable "Coordinate"
    Real MATC "2+tx(0)+tx(1)^2"
End


Solver 1 :: Reference Norm = 8.40086770E-01

