!---------------------------------------------------------------------
! Solves a Poisson equation where the temperature of the inner block is
! an unknown constant, set by "Temperature Constant" in a body force.
! The inner block is like an ideal conductor with a heat source.
! The result agrees with making the block highly conductive.
! Run also in parallel where the constant is a global dof shared by all
! partitions.
!--------------------------------------------------------------------

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "squares"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"

  Simulation Type = "Steady State"
  Steady State Max Iterations = 1
  Output Intervals = 1

  Post File = "case.vtu"
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
End

Body 1
  Name = "Body1"
  Body Force = 1
  Equation = 1
  Material = 1
End

Body 2
  Name = "Block"
  Body Force = 2
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equation1"
  Active Solvers(1) = 1
End

Solver 1
  Equation = "HeatEquation"
  Variable = "Temperature"
  Procedure = File "HeatSolve" "HeatSolver"

  Nonlinear System Consistent Norm = True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = "bicgstab"
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = ILU2
  Linear System Residual Output = 20

  Calculate Loads = True
  Calculate Boundary Fluxes = Logical True
End  


Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Parallel Reduce = Logical True
  Filename = f.dat
  Variable 1 = Temperature
  Operator 1 = boundary min
  Variable 2 = Temperature
  Operator 2 = boundary max
  Variable 3 = Temperature Loads
  Operator 3 = "boundary sum"

! The temperature of the block. Its boundary min and max are equal.
  Show Norm Index = 2
End 


Material 1
  Name = "Material1"

  Density = 1.0
  Heat Conductivity = 1.0
End

Body Force 1
  Name = "BodyForce1"
  Heat Source = 1.0
End

Body Force 2
  Name = "BlockConstant"
  Heat Source = 1.0
  Temperature Constant = Logical True
End

Boundary Condition 1
  Target Boundaries(1) = 1

  Temperature = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2 

  Save Scalars = True
End

Solver 1 :: Reference Norm = 6.00034060E-01
Solver 2 :: Reference Norm = 9.47481672E-01
