! The equal-order twin of Step3d.sif, and an unusually clean comparison: the
! shipped case runs "Stabilization Method = Stabilized" on the legacy FlowSolve,
! which is ALREADY an equal-order SUPG/PSPG pair. So this is not a bubble against
! a stabilised element, it is the same scheme in two independent implementations
! -- FlowSolve's NavierStokes.F90 against IncompressibleNSVec -- on one mesh.
!
! They agree to 0.09 % here (0.16323 against 0.16308), and both sit within 0.13 %
! of the MINI answer the same solver gives with a bubble. The residual difference
! is mostly tau: FlowSolve uses mK/8, which is 0.0208 on a hexahedron, against
! 0.0232 here, and it carries a grad-div term this does not.
!
! Solver 1 gains a reference norm, since the flow solution is what the
! stabilisation actually changes; solver 2's vorticity keeps its loose tolerance,
! being a derived quantity.
Header
  Mesh DB "." "Step3d"
  Include Path ""
  Results Directory ""
End


Simulation
  Max Output Level = 5
  Coordinate System =  Cartesian 3D
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Output Intervals = 1
!  Post File = "Step.vtu"
End


Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-8
End


Body 1
  Name = "Body1"
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equation1"
  Active Solvers(2) = 1 2
  Ns convect = Logical False
End


Solver 1
  Equation = "Navier-Stokes"
  Procedure = "IncompressibleNSVec" "IncompressibleNSSolver"

! Ns convect is already False in Equation 1; this is the same statement in the
! form the vectorized solver reads, and it is what lets the stabilised residual
! be complete -- see the transient/Stokes note in IncompressibleNSVec.
  Stokes Flow = Logical True
  Pressure Stabilization = Logical True
  Element = "n:1"

  Solver Timing = Logical True
  Bulk Assembly Timing = Logical True
  Linear System Timing = Logical True

  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500


  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU1
  Linear System Residual Output = 10
  Steady State Convergence Tolerance = 1.0e-5

  Nonlinear System Convergence Tolerance = 1.0e-5
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-2
  Nonlinear System Relaxation Factor = 1.0
End


Solver 2
  Equation = "VortisitySolver"
  Procedure = "VorticitySolver" "VorticitySolver"
End


Material 1
  Name = "Material1"
  Density = 1
  Viscosity = 0.01
End

Boundary Condition 1
  Name = "inlet"

  Target Boundaries = 1

  Velocity 1 = Variable Coordinate 2, Coordinate 3
    Real MATC "4*(tx(0)-1)*(2-tx(0))*(1+tx(1))*(1-tx(1))"
  Velocity 2 = 0
  Velocity 3 = 0
End

Boundary Condition 2
  Name = "outlet"
  Target Boundaries = 2

  Velocity 2 = 0
  Velocity 3 = 0
End

Boundary Condition 3
  Name = "walls"
  Target Boundaries(2) = 3 5

  Velocity 1 = 0
  Velocity 2 = 0
  Velocity 3 = 0
End

Boundary Condition 4
  Name = "symmetry"
  Target Boundaries = 4

  Velocity 3 = 0
End

Solver 1 :: Reference Norm = Real 0.16308254
Solver 2 :: Reference Norm = Real 0.883414964
Solver 2 :: Reference Norm Tolerance = Real 1e-2
RUN
