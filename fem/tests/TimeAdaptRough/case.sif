! Adaptive timestepping with "Adaptive Rough Timestep": the substeps are not
! cut at the end of the timestep, so the last one may overshoot it.
!
! The solution must be labelled with the time it really is at, and the next
! timestep is shortened by the overshoot so the nominal times are kept on
! average. Before, the time was set to the nominal time while the solution
! was ahead of it.
!
! The end time is 1.03185500E-02 (SaveScalars, Solver 2). BDF2 with 1000
! fixed steps to that time gives 0.81726889E-02; at the nominal time 0.01 the
! norm is 0.79426236E-02.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "Mesh"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 2D"
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = 0.001
  Timestep Intervals = 10
  Output Intervals = 0
  Steady State Max Iterations = 1

  Adaptive Timestepping = True
  Adaptive Time Error = 1.0e-3
  Adaptive Keep Smallest = 3
  Adaptive Min Timestep = 1.0e-6
  Adaptive Max Timestep = Real 0.001
  Adaptive Rough Timestep = True
End

Body 1
  Name = "Body1"
  Body Force = 1
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Equation1"
  Active Solvers(1) = 1
End

Solver 1
  Equation = "Heat Equation"
  Procedure = "HeatSolve" "HeatSolver"
  Variable = "Temperature"
  Linear System Solver = "Iterative"
  Linear System Iterative Method = "CG"
  Linear System Max Iterations = 100
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = None
  Stabilize = True
  Lumped Mass Matrix = True
  Steady State Convergence Tolerance = 1.0e-05
  Nonlinear System Convergence Tolerance = 1.0e-05
  Nonlinear System Max Iterations = 1
End

Solver 2
  Exec Solver = after timestep
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = time
  Show Norm Index = 1
End

Material 1
  Name = "Material1"
  Density = 1
  Heat Capacity = 1
  Heat Conductivity = 1
End

Body Force 1
  Name = "BodyForce1"
  Heat Source = 1
End

Boundary Condition 1
  Name = "Constraint1"
  Target Boundaries(6) = 1 2 3 4 5 6
  Temperature = 0
End

Solver 1 :: Reference Norm = Real 0.81729006E-02
Solver 1 :: Reference Norm Tolerance = Real 1.0e-5
Solver 2 :: Reference Norm = Real 1.03185500E-02
Solver 2 :: Reference Norm Tolerance = Real 1.0e-6
