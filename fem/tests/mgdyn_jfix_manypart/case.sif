! Steady AV solve with the source current made divergence free by the Jfix
! potential solver, run over enough partitions that the two systems the solver
! owns - the nodal Jfix potential and the edge/bubble AV system - no longer have
! the same set of interface partitions.  An interface block then arrives carrying
! rows owned by a partition that is not a mesh neighbour of ours, which is what
! makes ParInitMatrix() discover an extra neighbour after the fact.
!
! That used to leave ParEnv % NumOfNeighbours describing a different matrix than
! ParEnv % IsNeighbour sat beside it, so consumers sizing an array from the
! counter and filling it from the mask either overran the heap or silently
! dropped a neighbour.  See ParEnvNeighbourCount().
!
! The tested quantity is the electromagnetic field energy rather than the norm of
! AV: the latter is gauge dependent and the tree gauge follows the partitioning,
! so it is not comparable between serial and parallel runs.  The energy is
! partition independent, and was 1.763934370946E+04 for 1, 2, 4, 7 and 8 tasks.
! The bug showed up here as a heap corruption abort at 8 tasks.

Check Keywords "Warn"

Header
  Mesh DB "." "cube"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
!  Post File = zcurrent.ep
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End


Material 1
  Reluctivity  = Real 1
  Electric Conductivity = Real 1
End

Equation 1
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "MGDynamics"
  Variable = "P"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"

  Element = "n:1 e:1 -brick b:3 -quad_face b:2"
  Use Piola Transform = Logical True

  Bubbles in Global System = Logical True
  Fix Input Current Density = Logical True
  Linear System Row Equilibration = Logical True

  Linear System Solver = "Iterative"
  Linear System Preconditioning = ILU0
  Linear System Residual Output = 1
  Linear System Max Iterations = 500
  Linear System Iterative Method = gcr
  Linear System GCR Restart = 20
  Linear System Convergence Tolerance = 1.0e-10

! Before Linsolve = "EliminateDirichlet" "EliminateDirichlet"

  Steady State Convergence Tolerance = 1e-09
End

Solver 2
  Equation = "MGDynamicsCalc"
  Use Piola Transform = Logical True

  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Linear System Symmetric = True

  Potential Variable = String "P"

  Calculate Current Density = Logical True
  Calculate Magnetic Field Strength = Logical True
  Calculate Joule Heating = Logical True
  Calculate Elemental Fields = Logical True
  Calculate Nodal Fields = Logical False
!  Calculate Electric Field = Logical True
!  Calculate Magnetic Field Strength = Logical True
!  Calculate Magnetic Vector Potential = Logical True
  Steady State Convergence Tolerance = 0
  Linear System Solver = "Iterative"
  Linear System Preconditioning = None
  Linear System Residual Output = 0
  Linear System Max Iterations = 5000
  Linear System Iterative Method = CG
  Linear System Convergence Tolerance = 1.0e-8
End

Body Force 1
  Current Density 1 = Real 0.0
  Current Density 2 = Real 0.0
  Current Density 3 = Real 1.0e3
End

Boundary Condition 1
  Target Boundaries(4) = 1 2 3 4
  P {e} = Real 0
  P {e} 1 = Real 0
  P {e} 2 = Real 0
  P {e} 3 = Real 0
End

Boundary Condition 2
  Target Boundaries(1) = 5
  P = Real 2.0
  P {e} = Real 0
  P {e} 1 = Real 0
  P {e} 2 = Real 0
  P {e} 3 = Real 0
End

Boundary Condition 3
  Target Boundaries(1) = 6
  P = Real 0.0
  P {e} = Real 0
  P {e} 1 = Real 0
  P {e} 2 = Real 0
  P {e} 3 = Real 0
End

Solver 3
  Exec Solver = After All
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = f.dat
  Show Norm Index = 2
End

Solver 3 :: Reference Norm = Real 1.763934370946E+04
