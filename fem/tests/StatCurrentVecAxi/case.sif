! Axisymmetric/cylindric-symmetric regression test for StatCurrentSolve's
! vectorized bulk assembly (LocalMatrixVec): the integration weight there
! must be scaled by the interpolated radius, same as the scalar path's own
! "Weight = Weight * r", or the vectorized and scalar solutions disagree
! whenever "Coordinate System" is not Cartesian. This is otherwise untested:
! no other StatCurrentSolve test exercises a non-Cartesian coordinate system.
!
! Same mesh as StatCurrentVec2's angle.grd, single (non-namespaced) solver
! instance, plain Dirichlet BCs on the two straight edges of the L-shape.

Check Keywords Warn

Header
  Mesh DB "." "angle"
End

Simulation
  Max Output Level = 5
  Coordinate System = Axi Symmetric
  Simulation Type = Steady
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
  Material = 1
End

Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = StaticCurrent
  Variable = Potential
  Procedure = "StatCurrentSolve" "StatCurrentSolver"

  Vector Assembly = Logical True

  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 1
End

Material 1
  Electric Conductivity = 1.0
End

Boundary Condition 1
  Target Boundaries = 1
  Potential = Real 0.0
End

Boundary Condition 2
  Target Boundaries = 2
  Potential = Real 1.0
End

Solver 1 :: Reference Norm = Real 0.80970900

!End Of File
