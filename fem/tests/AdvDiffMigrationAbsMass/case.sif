! Nernst-Planck electromigration in AdvectionDiffusion, absolute mass units.
!
! Steady 1D diffusion + migration in a quiescent electrolyte. With a linear
! potential across the gap the exact solution is
!
!   C(y) = [exp(-b*y/Ly) - exp(-b)] / [1 - exp(-b)],   b = z*e*dphi/(kB*T)
!
! Here Ly = 1 mm, D = 1e-9 m^2/s, z = +1, T = 298.15 K, dphi = 0.05 V, so
! b = 1.946087. The reference norm is sensitive in both directions: it differs
! from the pure-diffusion (linear) profile that results when 'Ion Charge' stops
! being read, and from the profile obtained if the drift is scaled by an extra
! factor of the density.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "strip"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 2
  Output Intervals = 1
End

Constants
  Unit Charge = Real 1.602176634e-19
  Boltzmann Constant = Real 1.380649e-23
End

Body 1
  Name = "Electrolyte"
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Potential and species"
  Active Solvers(2) = 1 2
  Convection = "Constant"
  Concentration Units = String "Absolute Mass"
End

Solver 1
  Equation = "Stat Current Solver"
  Procedure = "StatCurrentSolve" "StatCurrentSolver"
  Variable = "Potential"
  Variable DOFs = 1
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 1
  Steady State Convergence Tolerance = 1.0e-10
End

Solver 2
  Equation = "Advection Diffusion"
  Procedure = "AdvectionDiffusion" "AdvectionDiffusionSolver"
  Variable = "Conc"
  Variable DOFs = 1
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 1
  Steady State Convergence Tolerance = 1.0e-10
  Bubbles = False
End

Material 1
  Name = "Binary electrolyte"
  Density = Real 1200.0
  Electric Conductivity = Real 10.0
  Conc Diffusivity = Real 1.0e-9
  Reference Temperature = Real 298.15
  Conc EPotential Field Variable = String "Potential"
  Conc Ion Charge = Real 1.0
  Convection Velocity 1 = Real 0.0
  Convection Velocity 2 = Real 0.0
End

Boundary Condition 1
  Name = "Inlet side, y = 0"
  Target Boundaries(1) = 1
  Potential = Real 0.0
  Conc = Real 1.0
End

Boundary Condition 2
  Name = "Electrode side, y = Ly"
  Target Boundaries(1) = 3
  Potential = Real 0.05
  Conc = Real 0.0
End

Solver 1 :: Reference Norm = Real 0.28903575E-01
Solver 2 :: Reference Norm = Real 0.44785448
