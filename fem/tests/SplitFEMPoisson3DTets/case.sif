! Test case for a cut-fem type of machinery in 3D with tets.
!
! Unlike other SplitFEMPoisson tests this case is steady state since the
! moving levelset and the isoline machinery are currently only available in 2D
! and extruded 3D.
!
! P.R. 18.11.2026

Header
  Mesh DB "." "rectangle-tet"
End

Simulation
  Max Output Level = 7
  Coordinate System = String Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1

  Post File = File "case.vtu"
!  vtu: Save Bulk Only = Logical True

!-----------------------------------------------------------
! Keywords for SplitFEM
!-----------------------------------------------------------
  SplitFem = logical True
  SplitFem Epsilon = Real 1.0e-3

! What BC index will be given for on-the-fly BC.
  SplitFem Interface BC = Integer 2
! What index will be given for negative levelset.
  SplitFEM inside body = integer 1
! for positive levelset.
  SplitFEM outside body = integer 0

! Should we save the actual splitted mesh in 3D?
  SplitFEM Mesh Save = Logical True

! We define a levelset to be used.
  Levelset Variable = String "Surface"
End

Body 1
  Name = String "inside"
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End


Initial Condition 1
  Name = "InitSurface"
$Rad=0.7
  Surface = Variable "Coordinate"
    Real MATC "tx(0)^2+tx(1)^2-Rad^2"
End

Equation 1
  Name = String "Equation1"
  Active Solvers(1) = 1
End


Solver 1
  Equation = "SplitFem"
  Variable = Potential
  Procedure = "ModelPDE" "AdvDiffSolver"

  Nonlinear System Max Iterations = 1

  Optimize Bandwidth = False

  Linear System Solver = iterative
  Linear System Iterative Method = "BiCGStab"
  Linear System Max Iterations = 1000
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = "ILU0"
  Linear System Residual Output = 20

  Exported Variable 1 = Surface

  SplitFEM = Logical True
End


Solver 2
  Equation = "SaveScalars"
  Exec Solver = After Timestep
  Procedure = "SaveData" "SaveScalars"
  Filename = "f.dat"
  Variable 1 = potential
  Operator 1 = min
  Operator 2 = max

  Show Norm Index = 2
End


Material 1
  Name = "ideal"
  Diffusion Coefficient = 1.0
End

Body Force 1
  Name = "InsideSource"
  Field Source = Real 1.0
End


Boundary Condition 1
  Name = String "CubeFaces"
  Target Boundaries(6) = 1 2 3 4 5 6
End

Boundary Condition 2
  Name = String "SplitFEM"
  Robin Coefficient = Real 1.0
  External Field = Real 0.0
End

! The reference norms have not been computed yet. Solver 2 shows the
! maximum potential which should be close to 0.3150 (see above).
Solver 1 :: Reference Norm = 3.91584179E-01
Solver 2 :: Reference Norm = 4.71923141E-01
