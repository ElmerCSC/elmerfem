! Transient simulation with a UMAT and adaptive timestepping: creep of a
! cantilever beam of a viscoelastic material (the standard linear solid of
! Zener.F90) under a constant body force, quasi-static.
!
! The UMAT integrates its rate equation over the timestep. Adaptive
! timestepping restores the state of the UMAT (stress, state and energy
! variables with their values at the previous time level) when it rejects
! or repeats a step, and the UMAT limits the step by PNEWDT to half of its
! relaxation time.
!
! The springs have the same Poisson ratio, so the deflection is that of the
! elastic beam times the creep compliance J(t)*E_0 with E_0 = E_inf+E_1:
! (E_0/E_inf) (1 - E_1/E_0 exp(-t/tau_c)), tau_c = tau E_0/E_inf = 0.02.
! The elastic beam with E_0 = 70e9 deflects 1.96124E-04 at the tip, so at
! t = 0.1 the deflection is 3.90926E-04. Implicit Euler with fixed dt=2e-5
! gives 3.90923E-04, this case 3.90292E-04 (tolerance 1e-3) with one
! rejected step.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "beam"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals = 4
  Timestep Sizes = 0.025
  Output Intervals = 0
  Steady State Max Iterations = 1

  Adaptive Timestepping = True
  Adaptive Time Error = 1.0e-3
  Adaptive Time Error Absolute = 1.0e-9
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Body Force 1
  Stress Bodyforce 2 = -1.0e5
End

Material 1
  Number of Material Constants = Integer 6
  Number of State Variables = Integer 4
  ! {density, E_inf, Poisson ratio, E_1, tau, max DTIME/tau}
  Material Constants(6) = Real 2700.0 35e9 0.3 35e9 0.01 0.5
  Density = 2700.0
  Reference Temperature = 293.0
  UMAT Subroutine = File "Zener" "zener"
  Name = "zener"
End

Solver 1
  Equation = Elasticity Solver
  Variable = Displacement
  Variable DOFs = 2
  Procedure = "ElasticSolve" "ElasticSolver"
  Linear System Solver = Direct
  Nonlinear System Max Iterations = 10
  Nonlinear System Convergence Tolerance = 1.0e-9
  Large Deflection = False
  Time Derivative Order = 1
  Quasi Stationary = Logical True
End

Solver 2
  Exec Solver = After Timestep
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = f.dat
  Variable 1 = Time
  Variable 2 = Displacement 2
  Operator 2 = min
  Show Norm Index = 2
End

Equation 1
  Active Solvers(2) = 1 2
  Plane Stress = False
End

Boundary Condition 1
  Target Boundaries = 1
  Displacement 1 = 0
  Displacement 2 = 0
End

Solver 2 :: Reference Norm = Real 3.90291703E-04
Solver 2 :: Reference Norm Tolerance = Real 1.0e-6
