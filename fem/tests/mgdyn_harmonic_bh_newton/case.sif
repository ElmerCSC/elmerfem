! Nonlinear time-harmonic problem (A-formulation) with a B-H curve and eddy currents: exact Newton
! ('Harmonic Newton Exact'). A cable (prescribed current density) through a conducting iron ring, quarter
! model. The eddy currents in the ring make the phase of B vary in space, so the conjugate part of the
! Jacobian matters.
Header
  CHECK KEYWORDS "Warn"
  Mesh DB "." "mesh_tet"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 3D"
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals = 0
End

Constants
  Permittivity of Vacuum = 8.8542e-12
End

Solver 1
  Equation = "MGDynamics"
  Variable = "P[P re:1 P im:1]"
  Procedure = "MagnetoDynamics" "WhitneyAVHarmonicSolver"
  ! A-formulation without scalar potential; the small conductivity in air and cable regularizes the system
  Element = "n:0 e:1"
  Use Tree Gauge = Logical False
  Angular Frequency = Real 3141.59265
  Fix Input Current Density = Logical True

  Nonlinear System Max Iterations = 12
  Nonlinear System Convergence Tolerance = 1.0e-7
  Nonlinear System Newton After Iterations = 0
  Harmonic Newton Exact = Logical True

  ! the exact Newton step reuses the factorization of the complex system in its inner iteration
  Linear System Solver = Direct
  Linear System Direct Method = MUMPS
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "P"
  Calculate Magnetic Flux Density = True
  Calculate Current Density = Logical True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Residual Output = 0
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 1
  Name = "Air"
  Electric Conductivity = 1.0
  Relative Permeability = 1.0
End

Material 2
  Name = "Iron"
  Electric Conductivity = 2.0e6
  H-B Curve = Variable "dummy"
    Real
      include HB
    End
End

Material 3
  Name = "Cable"
  Electric Conductivity = 1.0
  Relative Permeability = 1.0
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Body 2
  Target Bodies(1) = 2
  Equation = 1
  Material = 2
End

Body 3
  Target Bodies(1) = 3
  Equation = 1
  Material = 3
  Body Force = 1
End

Body Force 1
  Current Density 3 = Real 2.0e7
  Current Density im 3 = Real 0.0
End

Boundary Condition 1
  Name = "flux parallel"
  Target Boundaries(3) = 4 28 29
  P re {e} = Real 0
  P im {e} = Real 0
End

Boundary Condition 2
  Name = "cable ends"
  Target Boundaries(2) = 42 52
  P re {e} = Real 0
  P im {e} = Real 0
End

! exact Newton: 12 iterations to a change of 1e-9; the default iteration is at 715805.4 (change 1e-7) after 100
! iterations, 'Harmonic Newton Weight = 0.5' ends in a 2-cycle for this case
Solver 2 :: Reference Norm = Real 715809.44
Solver 2 :: Reference Norm Tolerance = Real 1.0e-5
RUN
