! geomstiff through ElasticSolve, against the reference value that test publishes
! for StressSolve. A prestressed vibration problem: an edge load puts the plate in a
! state of stress, the geometric stiffness of that state is added to the stiffness,
! and the eigenvalues that follow are the frequencies of the prestressed structure.
!
! Two passes are what the keyword means, and the test exercises both: the first solves
! the static problem with the eigen analysis switched off, the second builds the term
! from the stress it found. Removing the keyword leaves the plain vibration problem and
! the checked eigenvalue falls from 1.98E+02 to 1.10E+02, so the term is not decoration
! here.
!
! Note that the solver is named by its built-in equation name in the original, with no
! Procedure line -- the trap that hides a sixth of StressSolve's tests from a grep --
! so this mirror has to add one.
!
! Derived from fem/tests/geomstiff.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "geomstiff"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian 2D"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady State"
  Steady State Max Iterations = 1
  Output Intervals = 1

! Output File = "geomstiff.dat"
! Post File = "geomstiff.ep"
End

Constants
End

Body 1
  Equation = 1
  Material = 1
End

Equation 1
  Stress Analysis = Logical True
End


Solver 1
  Equation = "Stress Analysis"
  Procedure = "ElasticSolve" "ElasticSolver"
  Large Deflection = False
  Variable = "Displacement"
  Variable Dofs = 2
  Plane Stress = Logical True
  Geometric Stiffness = Logical True

  Eigen Analysis = True
  Eigen System Values = 10
  Eigen System Convergence Tolerance = Real 1.0e-6

  Linear System Scaling = Logical True
  Linear System Solver = Direct
! Linear System Direct Method = UMFPack

  Optimize Bandwidth = Logical True
End

Solver 2 
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
!  Filename = f.dat
  Show Norm = True
  Show Norm Index = 1

  Variable 1 = Displacement
  Save EigenValues = Logical True
End




Material 1
  Density = 1
  Youngs Modulus = 3.890733451865769e+04
  Poisson Ratio = 0.3
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Displacement 1 = 0
  Displacement 2 = 0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Force 1 = 20.0
End


Solver 2 :: Reference Norm = Real 1.979367879952E+002
Solver 2 :: Reference Norm Tolerance = Real 1e-4
RUN
