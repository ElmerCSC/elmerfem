$ Circuits = 1

! ------------------------ Circuit 1 ------------------------
! A voltage source driving a stranded coil (component 1) in series with a plain
! resistor (component 2). Elmer writes the component equation into the row of
! the component's voltage variable, so V = R*I is not written here.
!
! No permutation vector is set (all of C.1.perm stays zero), so the circuit
! variables get the natural numbering.
$ C.1.perm = zeros(6)

$ C.1.variables = 6
$ C.1.A = zeros(6,6)
$ C.1.B = zeros(6,6)
$ C.1.Mre = zeros(6,6)
$ C.1.Mim = zeros(6,6)

! Define variables.
$ C.1.name.1 = "i_testsource"
$ C.1.name.2 = "v_testsource"
$ C.1.name.3 = "i_component(1)"   ! stranded coil
$ C.1.name.4 = "v_component(1)"
$ C.1.name.5 = "i_component(2)"   ! resistor
$ C.1.name.6 = "v_component(2)"

! Define sources:
!------------------
$ C.1.B(0,1) = 1
$ C.1.source.1 = "testsource"

! Define network cycles:
!-------------------------
! Voltage relation: v_testsource = v_component(1) + v_component(2)
$ C.1.B(1,1) = -1
$ C.1.B(1,3) = 1
$ C.1.B(1,5) = 1
! Current relations: the three currents are the same, it is a series circuit.
$ C.1.B(2,0) = 1
$ C.1.B(2,2) = -1
$ C.1.B(4,0) = 1
$ C.1.B(4,4) = -1
