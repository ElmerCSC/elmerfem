! Test case that combines simple limiter and computation of
! sensitivity from the self-adjoint equation. 
!
! P.R. 18.5.2026

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "beam"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Steady state
  Steady State Max Iterations = 1

!  Post File = case.vtu
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
  Permittivity of Vacuum = 8.8542e-12
  Boltzmann Constant = 1.3807e-23
  Unit Charge = 1.602e-19
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Solver 1
  Equation = Linear elasticity
  Procedure = "StressSolve" "StressSolver"
  Variable = -dofs 2 Disp
  Steady State Convergence Tolerance = 1.0e-8
  Nonlinear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 30
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack

  Apply Limiter = Logical True

  Solve Adjoint Equation = Logical True  
  Adjoint Source Name = String "dForce"
End

Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"

  Operator 1 = max
  Variable 1 = disp adjoint 2 
  Show Norm Index = 1
  Filename = f.dat
End 

 
Equation 1
  Name = "Equation 1"
  Active Solvers(1) = 1
End

Material 1
  Youngs modulus = 1.0e3
  Density = 1.0
  Poisson ratio = 0.3
End

Body Force 1
  Stress Bodyforce 1 = 0
  Stress Bodyforce 2 = -20.0
  Stress Bodyforce 3 = 0

!  dForce 1 = Real 0.0
  dForce 2 = Real 10.0
End

Boundary Condition 1
  Name = Contact
  Target Boundaries(1) = 1

  Disp 2 Lower Limit = Variable Coordinate 1
    Real MATC "-0.5-0.2*(tx-5.5)^2"
End

Boundary Condition 2
  Name = Wall
  Target Boundaries(2) = 2 4
  Disp 1 = Real 0.0
  Disp 2 = Real 0.0
End


Solver 1 :: Reference Norm = 0.42834696093993385
Solver 2 :: Reference Norm = 2.83429746E-01
