! This case describes the flow through a very small hole
! where the flow is effectively Stokes flow. Then a flow resistance
! may be defined for the flow.
!
! This case includes noslip coefficient for the gas. 
! There is a variant of the case with slip conditions. 
! This is modern version of an old tutorial case which may 
! not be working anymore. 

Check Keywords Warn

Header
  Mesh DB "." "hole"
End

Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = steady state
  Steady State Max Iterations = 2
!  Output File = "flow.result"
!  Post File = "flow.vtu"
End

Body 1
  Name = "body_fluid"
  Equation = 1
  Material = 1
End

Equation 1
  Active Solvers(4) = 1 2 3 4
  NS Convect = False
End


Solver 1
  Equation = N-S
  Variable = Flow Solution[Velocity:3 Pressure:1]
  Procedure = "FlowSolve" "FlowSolver"
  Linear System Solver = iterative
  Linear System Iterative Method = bicgstabl
  linear system use hypre = logical false
  BiCgStabl Polynomial Degree = Integer 4 
  Linear System Preconditioning = ilu0
  Linear System Max Iterations = 1000
  Linear System Convergence Tolerance = 1.0e-08
  linear system residual output= 10
  linear system abort not converged = false
  Stabilize = True
  Nonlinear System Convergence Tolerance = 1.0e-05
  Nonlinear System Max Iterations = 10
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-08
  Nonlinear System Relaxation Factor = 1.0
  Steady State Convergence Tolerance = 1.0e-05

  linear system save = logical true
  linear system save adios2 = logical true
  linear system save slot = after
  linear system save solution = logical true

  Calculate Loads = Logical True
End

Solver 2
  Equation = Fluidic Force
  Procedure  ="FluidicForce" "ForceCompute"
  Calculate Viscous Force = True
End

Solver 3
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"

! If filename is not given, echos the results only
!  Filename = "flowdata.dat"

! compute the more accurate force eastimate from the nodal loads
  Operator 1 = boundary sum
  Variable 1 = Flow Solution Loads 1
  Operator 2 = boundary sum
  Variable 2 = Flow Solution Loads 2
  Operator 3 = boundary sum
  Variable 3 = Flow Solution Loads 3

! use this norm to ensure consistency
  Show Norm Index = 3
End 

solver 4
  equation = saveadios
  procedure = "ADIOS2OutputSolver" "ADIOS2OutputSolver"
  vector field 1 = velocity
  scalar field 1 = pressure
  output file name = "results.bp"
end

Material 1
  Name = Air
  Density = 1.293
  Viscosity = 1.67e-5
End

Boundary Condition 1
  Name = "bc_moving" 
  Target Boundaries = 4
  Velocity 1 = 0.0
  Velocity 2 = 0.0
  Velocity 3 = 1.0
  Calculate Fluidic Force = True
  Save Scalars = Logical True
End

Boundary Condition 2
  Name = "bc_noslip"
  Target Boundaries(4) = 1 2 3 7
  Velocity 1 = 0.0
  Velocity 2 = 0.0
  Velocity 3 = 0.0
End

Boundary Condition 3
  Name = "bc_symmetry_y"
  Target Boundaries(2) = 8 10
  Velocity 2 = 0.0
End

Boundary Condition 4
  Name = "bc_symmetry_x"
  Target Boundaries(2) = 6 9
  Velocity 1 = 0.0
End

Boundary Condition 5
  Name = "bc_outlet"
  Target Boundaries = 5
End

Solver 3 :: Reference Norm = Real 3.760536636896E-002
RUN
