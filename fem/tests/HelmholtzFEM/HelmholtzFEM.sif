$ fem = 1
$ r =  1.224
$ c = 340
$ w = 15000
$ k = w / c

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "MeshFiles"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 7
  Angular Frequency = $ if( fem ) { w } else { k }

  Coordinate System = "Cartesian 2D"
  Coordinate Mapping(3) = 1 2 3

  Simulation Type = "Steady State"
  Steady State Max Iterations = 1
  Output Intervals = 1

! Output File = "CircleInBox.dat"
! Post File = "CircleInBox.vtu"
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
End

Body 1
  Equation = 1
  Material = 1
End

Equation 1
  Helmholtz = Logical True
End

Solver 1
  Equation = "Helmholtz"
  Variable = "Pressure"
  Variable Dofs = 2

  $ if( fem ) { "Procedure = \"HelmholtzSolve\" \"HelmholtzSolver\" " } \
      else    { "Procedure = \"HelmholtzBEM\" \"HelmholtzBEMSolver\" " }

  Exported Variable 1 = Flux
  Exported Variable 1 DOFs = 2

  Linear System Solver = $ if( ~fem ) { "Direct" } else { "Iterative" }
  Linear System Iterative Method = "BiCGStab"

! The reference norms below are the serial ones, and the default norm is
! summed over each partition's own rows, so shared nodes are counted once per
! owner and the reported value drifts with the partition count -- 1.3e-3 from
! serial at np=2 and 2.1e-3 at np=4, purely in the reporting, with the
! solution itself correct. This makes the norm partition independent so the
! same references hold for every task count.
  Nonlinear System Consistent Norm = Logical True
  Linear System Max Iterations = 300
  Linear System Convergence Tolerance = 1.0e-08
  Linear System Abort Not Converged = True
  Linear System Preconditioning = "ILU2"
  Linear System Residual Output = 1
  Linear System Precondition Recompute = 1
  Linear System Preconditioning Damp Coefficient Im = 1.0

  Steady State Convergence Tolerance = 1.0e-05

  Nonlinear System Convergence Tolerance = 1.0e-05
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-02
  Nonlinear System Relaxation Factor = 1

  Optimize Bandwidth = $ if( fem ) { "TRUE" } else { "FALSE" }
End

Material 1
  Density = $ r
  Sound Speed = $ c
End

Boundary Condition 1
  Name = "circle_bc"
  Normal Target Body = 0  ! Change normal direction if desired
  Target Boundaries(1) = 2
  $ if( ~fem ) { "Body Id = 1" }
  Wave Flux 1 = 1 ! fem
  Flux 1 = Real 1 ! bem
End

Boundary Condition 2
  Name = "box_bc"
  Target Boundaries(1) = 1
  Wave Impedance 1 = Real $ c
End

Solver 1 :: Reference Norm = Real 0.128318191837E-01
RUN

! Second pass exercises complex CG. The Helmholtz operator is complex
! SYMMETRIC but not Hermitian, so CG is only valid with the unconjugated
! bilinear form x^T y; with the conjugating (Hermitian) dot product it has no
! self-adjoint operator to work with.
!
! The angular frequency is changed so that this is a genuine cold start: the
! reload keeps Pressure from the previous pass, and at the same frequency that
! is already the converged solution, which any solver would "confirm" in one
! iteration. The reference norm below was cross-checked by solving the same
! frequency with BiCGStab from a cold start.
Simulation :: Angular Frequency = Real 20000
Solver 1 :: Linear System Iterative Method = String "CG"
Solver 1 :: Reference Norm = Real 0.990092197E-02
RUN

