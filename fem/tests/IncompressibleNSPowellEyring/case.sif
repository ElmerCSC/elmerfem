! Regression test for "Viscosity Model = Powell Eyring" in IncompressibleNS:
! mu = mu0 + c1*asinh(c2*s)/(c2*s), s = sqrt(ss) the shear rate. The value
! used to divide by c2*ss instead of c2*s, and its Newton derivative (here and
! in MaterialModels.F90) had a c2 for c2^2; the derivative is now checked
! against finite differences.
!
! Lid-driven cavity, Re = 1000, 20x20 quads, default bubbles, Newton (9
! iterations, same solution as Picard to 1e-8). FlowSolve on the same case
! agrees to 1.2e-2 in max|u|, as for the laminar case with these two bubble
! spaces. Pressure is checked separately (max|p| by SaveScalars).

Check Keywords Warn
Header
  Mesh DB "." "cavity"
End
Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End
Body 1
  Equation = 1
  Material = 1
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
  Nonlinear System Max Iterations = 300
  Nonlinear System Convergence Tolerance = 1.0e-10
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
End
Solver 2
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Variable 1 = Pressure
  Operator 1 = max abs
  Show Norm Index = 1
End
Material 1
  Density = 1.0
  Viscosity = 1.0e-3
  Viscosity Model = Powell Eyring
  Viscosity Difference = 0.01
  Viscosity Transition = 2.0
End
Boundary Condition 1
  Target Boundaries(3) = 1 2 4
  Velocity 1 = 0
  Velocity 2 = 0
End
Boundary Condition 2
  Target Boundaries(1) = 3
  Velocity 1 = 1
  Velocity 2 = 0
End
Boundary Condition 3
  Target Coordinates(1,2) = 0.5 0.0
  Pressure = 0.0
End

Solver 1 :: Reference Norm = Real 1.69816801E-01
Solver 1 :: Reference Norm Tolerance = Real 1.0e-5
! max|p|
Solver 2 :: Reference Norm = Real 8.36312493E-01
Solver 2 :: Reference Norm Tolerance = Real 1.0e-5
