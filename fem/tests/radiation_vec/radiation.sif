! Vectorized-assembly twin of ../radiation/radiation.sif: same axially
! symmetric radiation case, but with "Vector Assembly = True" forced on, to
! exercise HeatSolve's vectorized bulk assembly (LocalMatrixVec) in the
! axisymmetric case. Its integration weight must be scaled by the
! interpolated radius, same as the scalar path's own "Weight = Weight * r",
! or the vectorized and scalar solutions disagree. This was previously
! untested: Vector Assembly used to be forced off whenever the coordinate
! system was non-Cartesian.
!
! The Radiation BC term itself (LocalMatrixBC) is never vectorized -- see
! ../radiation/radiation.sif's own header comment on the (unrelated)
! HeatSolveVec-vs-legacy nodal/Gauss-point discretization difference for
! that term -- so this test isolates the bulk conduction/source assembly.

Check Keywords Warn

Header
  Mesh DB "." "radiation"
End

Constants
  Stefan Boltzmann = 5.67e-8
End

Simulation
  Max Output Level = 5
  Coordinate System = Axi Symmetric
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
End

Body 1
  Equation = 1
  Body Force = 1
  Material = 1
  Initial Condition = 1
End

Body 2
  Equation = 1
  Material = 2
  Initial Condition = 1
End

Initial Condition 1
  Temperature = 250.0
End

Body Force 1
  Heat Source = 10000
End

Material 1
   Density = 1.0
   Heat Conductivity = 10.0
   Heat Capacity = 1.0
End

Material 2
   Density = 1.0
   Heat Conductivity = 1.0
   Heat Capacity = 1.0
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature

  Vector Assembly = Logical True

  Stabilize = True
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Convergence Tolerance = 1.0e-12
  Linear System Max Iterations = 500
  Linear System Preconditioning = ILU
  Nonlinear System Newton After Iterations = 1
  Nonlinear System Newton After Tolerance = 1.0e-4
  Nonlinear System Max Iterations = 50
  Nonlinear System Consistent Norm = True
  NonLinear System Convergence Tolerance = 1.0e-8
  Steady State Convergence Tolerance = 1.0e-8
  Nonlinear System Relaxation Factor = 0.7
End

Equation 1
  Active Solvers = 1
End

Boundary Condition 1
   Target Boundaries = 1
   Heat Flux BC = True
   Radiation = Diffuse Gray
   Radiation Target Body = -1
   Emissivity = 0.6
End

Boundary Condition 2
   Target Boundaries = 2
   Heat Flux BC = True
   Radiation = Diffuse Gray
   Radiation Target Body = -1
   Emissivity = 0.1
End

Boundary Condition 3
   Target Boundaries = 3
   Temperature = 100.0
End

Solver 1 :: Reference Norm = Real 245.276478
Solver 1 :: Reference Norm Tolerance = Real 1.0e-4
