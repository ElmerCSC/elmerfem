! Same problem as ../NaturalConvection, with Solver 2 switched from the legacy
! FlowSolve to IncompressibleNS, exercising its new Body Force "Boussinesq"
! flag (see IncompressibleNS.F90, LocalBulkMatrix) -- the plain buoyancy-only
! approximation, unlike ../ThermalCompress_vec's "Compressibility Model =
! Thermal". "Stabilize = True" is kept on purpose here (unlike
! ThermalCompress_vec): Boussinesq never touches the continuity row, so it
! is compatible with the equal-order Pressure Stabilization path too, not
! just velocity bubbles.
$ relax = 0.7

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "square"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Transient
  Steady State Max Iterations = 20
  Timestepping Method = BDF
  BDF Order = 2
  Timestep intervals(1) = 3
  Timestep Sizes(1) = 100.0
  Output Intervals(1) = 0
!  Post File = case.vtu
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
  Permittivity of Vacuum = 8.8542e-12
  Boltzmann Constant = 1.3807e-23
  Unit Charge = 1.602e-19
End

Body 1
  Target Bodies(1) = 1
  Name = "Body 1"
  Equation = 1
  Material = 1
  Body Force = 1
  Initial condition = 1
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = -dofs 1 Temperature
  Stabilize = True
  Bubbles = False
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5

  Nonlinear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = $ relax

  Linear System Symmetric = True
  Linear System Solver = Iterative
  Linear System Iterative Method = GCR
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
End

Solver 2
  Equation = Navier-Stokes
  Procedure = "IncompressibleNS" "IncompressibleNSSolver"
  Stabilize = True
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5

  Nonlinear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = $ relax

  Linear System Symmetric = True
  Linear System Solver = Iterative
  Linear System Iterative Method = Bicgstabl
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = ILU0
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
End



Equation 1
  Name = "Natural Convection"
  Convection = Computed
  Active Solvers(2) = 1 2
End

Material 1
  Name = "Water (room temperature)"
  Heat Conductivity = 0.58
  Reference Temperature = 293.0
  Heat Capacity = 4183.0
  Density = 998.3
  Viscosity = 1.002e-3
  Sound speed = 1497.0
  Heat expansion Coefficient = 0.207e-3
End

Body Force 1
  Name = "Bouancy"
  Boussinesq = True
End

Initial Condition 1
  Name = "Initial Guess"
  Velocity 2 = 0.0
  Velocity 1 = 1.0e-9
  Temperature = 295
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "Bottom"
  Velocity 1 = 0.0
  Velocity 2 = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Name = "Right"
  Velocity 1 = 0.0
  Velocity 2 = 0.0
  Temperature = 297.0
End

Boundary Condition 3
  Target Boundaries(1) = 3
  Name = "Top"
  Velocity 2 = 0.0
End

Boundary Condition 4
  Target Boundaries(1) = 4
  Name = "Left"
  Velocity 1 = 0.0
  Velocity 2 = 0.0
  Temperature = 293.0
End

! ../NaturalConvection runs this same problem (same mesh, same Body Force
! "Boussinesq") on the legacy FlowSolve, which converges to 2.75036670E-04 --
! 0.15% away from the norm below, consistent with the discretisation
! difference between the two solvers, not a sign either is wrong.
Solver 2 :: Reference Norm = Real 2.75444761E-04
RUN
